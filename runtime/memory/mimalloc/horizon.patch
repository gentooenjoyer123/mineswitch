   size_t align_size;
+#if defined(MI_MINESWITCH)
+  /* The Horizon backend has fixed, eagerly backed RAM and no large pages.
+   * Desktop-scale rounding is paid in real retained capacity (and can happen
+   * twice: payload and segment metadata). Keep the actual page granularity. */
+  align_size = _mi_os_page_size();
+#else
   if (size < 512*MI_KiB) align_size = _mi_os_page_size();
   else if (size < 2*MI_MiB) align_size = 64*MI_KiB;
   else if (size < 8*MI_MiB) align_size = 256*MI_KiB;
   else if (size < 32*MI_MiB) align_size = 1*MI_MiB;
   else align_size = 4*MI_MiB;
+#endif
   if mi_unlikely(size >= (SIZE_MAX - align_size)) return size; // possible overflow?
   return _mi_align_up(size, align_size);
 }
