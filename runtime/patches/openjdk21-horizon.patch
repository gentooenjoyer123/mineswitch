+ * This code is distributed under GNU GPL version 2; see the OpenJDK LICENSE.
+ */
+#ifndef OS_CPU_HORIZON_AARCH64_ICACHE_HORIZON_AARCH64_HPP
+#define OS_CPU_HORIZON_AARCH64_ICACHE_HORIZON_AARCH64_HPP
+
+// The C bridge cleans the writable alias and invalidates the executable alias.
+// It must be linked with the genuine CodeMemory backend; there is no no-op
+// or writable-as-executable fallback.
+extern "C" void nxjit_flush_instruction_cache(void* address, size_t bytes);
+
+class ICache : public AbstractICache {
+ public:
+  static void initialize();
+  static void invalidate_word(address location) {
+    nxjit_flush_instruction_cache(location, 4);
+  }
+  static void invalidate_range(address start, int bytes) {
+    assert(bytes >= 0, "invalid instruction cache range");
+    if (bytes > 0) nxjit_flush_instruction_cache(start, (size_t)bytes);
+  }
+};
+
+#endif
