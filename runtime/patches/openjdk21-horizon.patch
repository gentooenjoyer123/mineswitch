@@ -0,0 +1,51 @@
+/* Copyright (c) 2026 MineSwitch contributors. SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */
+#include "jni_util.h"
+#include "java_util_prefs_FileSystemPreferences.h"
+#include "horizon_file_io.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+
+DEF_STATIC_JNI_OnLoad
+
+JNIEXPORT jint JNICALL Java_java_util_prefs_FileSystemPreferences_chmod
+  (JNIEnv *env, jclass type, jstring name, jint mode) {
+    const char *path = JNU_GetStringPlatformChars(env, name, NULL);
+    if (!path) return ENOMEM;
+    int result = chmod(path, mode), error = result < 0 ? errno : 0;
+    JNU_ReleaseStringPlatformChars(env, name, path);
+    return error;
+}
+
+JNIEXPORT jintArray JNICALL Java_java_util_prefs_FileSystemPreferences_lockFile0
+  (JNIEnv *env, jclass type, jstring name, jint mode, jboolean shared) {
+    jint result[2] = {0, 0};
+    const char *path = JNU_GetStringPlatformChars(env, name, NULL);
+    if (!path) return NULL;
+    if (shared) {
+        result[1] = ENOTSUP;
+    } else {
+        int fd = nxio_open(path, O_WRONLY | O_CREAT, mode);
+        if (fd < 0) result[1] = errno;
+        else if (nxio_lock_whole_file(fd) < 0) {
+            result[1] = errno;
+            nxio_close(fd);
+        } else {
+            result[0] = fd + 1; /* The JNI cookie reserves zero for failure. */
+        }
+    }
+    JNU_ReleaseStringPlatformChars(env, name, path);
+    jintArray answer = (*env)->NewIntArray(env, 2);
+    if (answer) (*env)->SetIntArrayRegion(env, answer, 0, 2, result);
+    if (!answer && result[0]) nxio_close(result[0] - 1);
+    return answer;
+}
+
+JNIEXPORT jint JNICALL Java_java_util_prefs_FileSystemPreferences_unlockFile0
+  (JNIEnv *env, jclass type, jint cookie) {
+    if (cookie <= 0) return EBADF;
+    int fd = cookie - 1;
+    int result = nxio_unlock_whole_file(fd), error = result < 0 ? errno : 0;
+    if (nxio_close(fd) < 0 && !error) error = errno;
+    return error;
+}
