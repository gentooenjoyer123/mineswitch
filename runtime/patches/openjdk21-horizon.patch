+ * Please contact Oracle, 500 Oracle Parkway, Redwood Shores, CA 94065 USA
+ * or visit www.oracle.com if you need additional information or have any
+ * questions.
+ *
+ */
+
+#ifndef OS_HORIZON_OS_HORIZON_INLINE_HPP
+#define OS_HORIZON_OS_HORIZON_INLINE_HPP
+#include "runtime/os.hpp"
+#include "runtime/mutex.hpp"
+#include <errno.h>
+inline bool os::zero_page_read_protected() { return true; }
+// Zero checks stack bounds explicitly. Native AArch64 uses the own-thread
+// exception adapter and protected pages in its real libnx stack mapping.
+inline bool os::uses_stack_guard_pages() {
+#ifdef ZERO
+  return false;
+#else
+  return true;
+#endif
+}
+inline bool os::must_commit_stack_guard_pages() { return false; }
+inline void os::map_stack_shadow_pages(address sp) {}
+inline bool os::can_trim_native_heap() { return false; }
+inline bool os::numa_has_group_homing() { return false; }
+inline void PlatformMutex::lock() {
+  int r=pthread_mutex_lock(mutex()); guarantee(r==0,"pthread_mutex_lock: %d",r);
+}
+inline void PlatformMutex::unlock() {
+  int r=pthread_mutex_unlock(mutex()); guarantee(r==0,"pthread_mutex_unlock: %d",r);
+}
+inline bool PlatformMutex::try_lock() {
+  int r=pthread_mutex_trylock(mutex()); guarantee(r==0||r==EBUSY,"pthread_mutex_trylock: %d",r); return r==0;
+}
+inline void PlatformMonitor::notify() {
+  int r=pthread_cond_signal(cond()); guarantee(r==0,"pthread_cond_signal: %d",r);
+}
+inline void PlatformMonitor::notify_all() {
+  int r=pthread_cond_broadcast(cond()); guarantee(r==0,"pthread_cond_broadcast: %d",r);
+}
+#endif
