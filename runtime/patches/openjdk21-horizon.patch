+char* os::build_agent_function_name(const char* symbol,const char* library,bool absolute) {
+  if (!library) return os::strdup(symbol,mtThread);
+  const char* basename=library;
+  size_t length=strlen(library);
+  if (absolute) {
+    const char* slash=strrchr(library,'/'); if (slash) basename=slash+1;
+    if (!strncmp(basename,JNI_LIB_PREFIX,strlen(JNI_LIB_PREFIX))) basename+=strlen(JNI_LIB_PREFIX);
+    length=strlen(basename);
+    size_t suffix=strlen(JNI_LIB_SUFFIX);
+    if (length>=suffix && !strcmp(basename+length-suffix,JNI_LIB_SUFFIX)) length-=suffix;
+  }
+  size_t bytes=strlen(symbol)+length+2;
+  char* result=NEW_C_HEAP_ARRAY_RETURN_NULL(char,bytes,mtThread);
+  if (result) jio_snprintf(result,bytes,"%s_%.*s",symbol,(int)length,basename);
+  return result;
+}
