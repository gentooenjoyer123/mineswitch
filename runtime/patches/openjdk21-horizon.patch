@@ -0,0 +1,178 @@
+/* Full own-thread exception adapter using the public libnx/kernel frame.
+ * No process-wide exception buffer or stack is used. x0..x8, LR, SP, PC and
+ * PSTATE come from ThreadExceptionFrameA64; all other registers remain live.
+ * The installed __aarch64_read_tp is a leaf using only x0 (audited separately).
+ * It can therefore find local-exec TLS before touching a potentially exhausted
+ * application stack. Unknown faults and recursive faults remain unhandled.
+ */
+.arch armv8-a
+.section .text.__libnx_exception_entry,"ax",%progbits
+.p2align 2
+.global __libnx_exception_entry
+.type __libnx_exception_entry,%function
+__libnx_exception_entry:
+    cbz x1, .Lhorizon_unhandled
+    /* Preserve the existing SafeFetch contract even before VM TLS exists. */
+    cmp w0, #0x101
+    b.ne .Lhorizon_full_context
+    ldr w2, [x1, #108]
+    tbnz w2, #6, .Lhorizon_full_context
+    lsr w2, w2, #26
+    cmp w2, #0x24
+    b.ne .Lhorizon_full_context
+    ldr x2, [x1, #88]
+    adrp x3, nxvm_safe_fetch32
+    add x3, x3, :lo12:nxvm_safe_fetch32
+    cmp x2, x3
+    b.eq .Lhorizon_safe_fetch
+    adrp x3, nxvm_safe_fetch_word
+    add x3, x3, :lo12:nxvm_safe_fetch_word
+    cmp x2, x3
+    b.ne .Lhorizon_full_context
+.Lhorizon_safe_fetch:
+    add x3, x3, #4
+    ldr x2, [x1, #8]
+    str x2, [x1]
+    str x3, [x1, #88]
+    mov w0, wzr
+    svc #0x28
+    b .Lhorizon_unhandled
+
+.Lhorizon_full_context:
+    mov w8, w0
+    /* This SDK helper preserves x1..x29, NEON and flags; original LR is saved
+     * in the kernel frame. No stack access is made by this call. */
+    bl __aarch64_read_tp
+    add x2, x0, #:tprel_hi12:horizon_aarch64_fault_state
+    add x2, x2, #:tprel_lo12_nc:horizon_aarch64_fault_state
+    ldr x3, [x2]
+    cbz x3, .Lhorizon_unhandled
+    ldr x4, [x2, #8]
+    cbnz x4, .Lhorizon_unhandled
+    mov x4, #1
+    str x4, [x2, #8]
+    sub x3, x3, #832
+    /* Save the live registers before any C calling convention can clobber. */
+    stp x9, x10, [x3, #72]
+    stp x11, x12, [x3, #88]
+    stp x13, x14, [x3, #104]
+    stp x15, x16, [x3, #120]
+    stp x17, x18, [x3, #136]
+    stp x19, x20, [x3, #152]
+    stp x21, x22, [x3, #168]
+    stp x23, x24, [x3, #184]
+    stp x25, x26, [x3, #200]
+    stp x27, x28, [x3, #216]
+    str x29, [x3, #232]
+    ldp x4, x5, [x1]
+    stp x4, x5, [x3]
+    ldp x4, x5, [x1, #16]
+    stp x4, x5, [x3, #16]
+    ldp x4, x5, [x1, #32]
+    stp x4, x5, [x3, #32]
+    ldp x4, x5, [x1, #48]
+    stp x4, x5, [x3, #48]
+    ldr x4, [x1, #64]
+    str x4, [x3, #64]
+    ldp x4, x5, [x1, #72]
+    stp x4, x5, [x3, #240]
+    ldr x4, [x1, #88]
+    str x4, [x3, #256]
+    ldr x4, [x1, #112]
+    str x4, [x3, #264]
+    mrs x4, fpcr
+    mrs x5, fpsr
+    stp x4, x5, [x3, #272]
+    ldr w4, [x1, #96]
+    ldr w5, [x1, #108]
+    str w4, [x3, #288]
+    str w5, [x3, #292]
+    str w8, [x3, #296]
+    str wzr, [x3, #300]
+    stp x1, x2, [x3, #304]
+    stp q0, q1, [x3, #320]
+    stp q2, q3, [x3, #352]
+    stp q4, q5, [x3, #384]
+    stp q6, q7, [x3, #416]
+    stp q8, q9, [x3, #448]
+    stp q10, q11, [x3, #480]
+    stp q12, q13, [x3, #512]
+    stp q14, q15, [x3, #544]
+    stp q16, q17, [x3, #576]
+    stp q18, q19, [x3, #608]
+    stp q20, q21, [x3, #640]
+    stp q22, q23, [x3, #672]
+    stp q24, q25, [x3, #704]
+    stp q26, q27, [x3, #736]
+    stp q28, q29, [x3, #768]
+    stp q30, q31, [x3, #800]
+    mov sp, x3
+    mov x29, xzr
+    mov x0, x3
+    bl horizon_aarch64_handle_exception
+    mov x2, sp
+    str w0, [x2, #300]
+    cbnz w0, .Lhorizon_restore_context
+    mov x0, sp
+    bl horizon_aarch64_report_unhandled
+    mov x2, sp
+.Lhorizon_restore_context:
+    ldp x1, x3, [x2, #304]
+    str xzr, [x3, #8]
+    ldp x3, x4, [x2]
+    stp x3, x4, [x1]
+    ldp x3, x4, [x2, #16]
+    stp x3, x4, [x1, #16]
+    ldp x3, x4, [x2, #32]
+    stp x3, x4, [x1, #32]
+    ldp x3, x4, [x2, #48]
+    stp x3, x4, [x1, #48]
+    ldr x3, [x2, #64]
+    str x3, [x1, #64]
+    ldp x3, x4, [x2, #240]
+    stp x3, x4, [x1, #72]
+    ldr x3, [x2, #256]
+    str x3, [x1, #88]
+    ldr w3, [x2, #288]
+    str w3, [x1, #96]
+    ldp x3, x4, [x2, #272]
+    msr fpcr, x3
+    msr fpsr, x4
+    ldp q0, q1, [x2, #320]
+    ldp q2, q3, [x2, #352]
+    ldp q4, q5, [x2, #384]
+    ldp q6, q7, [x2, #416]
+    ldp q8, q9, [x2, #448]
+    ldp q10, q11, [x2, #480]
+    ldp q12, q13, [x2, #512]
+    ldp q14, q15, [x2, #544]
+    ldp q16, q17, [x2, #576]
+    ldp q18, q19, [x2, #608]
+    ldp q20, q21, [x2, #640]
+    ldp q22, q23, [x2, #672]
+    ldp q24, q25, [x2, #704]
+    ldp q26, q27, [x2, #736]
+    ldp q28, q29, [x2, #768]
+    ldp q30, q31, [x2, #800]
+    ldp x9, x10, [x2, #72]
+    ldp x11, x12, [x2, #88]
+    ldp x13, x14, [x2, #104]
+    ldp x15, x16, [x2, #120]
+    ldp x17, x18, [x2, #136]
+    ldp x19, x20, [x2, #152]
+    ldp x21, x22, [x2, #168]
+    ldp x23, x24, [x2, #184]
+    ldp x25, x26, [x2, #200]
+    ldp x27, x28, [x2, #216]
+    ldr x29, [x2, #232]
+    ldr w3, [x2, #300]
+    cmp w3, #0
+    mov w0, #0xf801
+    csel w0, wzr, w0, ne
+    svc #0x28
+.Lhorizon_unhandled:
+    mov w0, #0xf801
+    svc #0x28
+    b .Lhorizon_unhandled
+.size __libnx_exception_entry,.-__libnx_exception_entry
+.section .note.GNU-stack,"",%progbits
