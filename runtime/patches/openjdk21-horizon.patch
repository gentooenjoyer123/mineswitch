+package sun.nio.fs;
+
+import java.io.IOException;
+import java.nio.file.FileStore;
+import java.nio.file.attribute.BasicFileAttributeView;
+import java.nio.file.attribute.FileAttributeView;
+import java.nio.file.attribute.FileStoreAttributeView;
+
+/** Capacity comes from the actual mounted filesystem's statvfs dispatcher. */
+final class HorizonFileStore extends FileStore {
+    private final UnixPath path;
+    HorizonFileStore(UnixPath path) throws IOException {
+        this.path = path;
+        attributes(); // Verify the path and filesystem instead of inventing capacity.
+    }
+    private UnixFileStoreAttributes attributes() throws IOException {
+        try {
+            return UnixFileStoreAttributes.get(path);
+        } catch (UnixException error) {
+            error.rethrowAsIOException(path);
+            throw new AssertionError();
+        }
+    }
+    private static long bytes(long blocks, long size) {
+        try { return Math.multiplyExact(blocks, size); }
+        catch (ArithmeticException overflow) { return Long.MAX_VALUE; }
+    }
+    @Override public String name() { return "sdmc"; }
+    @Override public String type() { return "horizon"; }
+    @Override public boolean isReadOnly() {
+        try (NativeBuffer buffer = UnixNativeDispatcher.copyToNativeBuffer(path)) {
+            return isReadOnly0(buffer.address());
+        }
+    }
+    @Override public long getTotalSpace() throws IOException {
+        var info = attributes(); return bytes(info.totalBlocks(), info.blockSize());
+    }
+    @Override public long getUsableSpace() throws IOException {
+        var info = attributes(); return bytes(info.availableBlocks(), info.blockSize());
+    }
+    @Override public long getUnallocatedSpace() throws IOException {
+        var info = attributes(); return bytes(info.freeBlocks(), info.blockSize());
+    }
+    @Override public boolean supportsFileAttributeView(Class<? extends FileAttributeView> type) {
+        return type == BasicFileAttributeView.class;
+    }
+    @Override public boolean supportsFileAttributeView(String name) { return "basic".equals(name); }
+    @Override public <V extends FileStoreAttributeView> V getFileStoreAttributeView(Class<V> type) {
+        return null;
+    }
+    @Override public Object getAttribute(String attribute) throws IOException {
+        return switch (attribute) {
+            case "totalSpace" -> getTotalSpace();
+            case "usableSpace" -> getUsableSpace();
+            case "unallocatedSpace" -> getUnallocatedSpace();
+            default -> throw new UnsupportedOperationException(attribute);
+        };
+    }
+    private static native boolean isReadOnly0(long pathAddress);
+}
