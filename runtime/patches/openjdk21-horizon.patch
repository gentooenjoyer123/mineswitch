+#include "precompiled.hpp"
+#include "semaphore_horizon.hpp"
+SemaphoreImpl::SemaphoreImpl(uint value): _count(value) {
+  guarantee(pthread_mutex_init(&_mutex,nullptr)==0,"semaphore mutex init");
+  guarantee(pthread_cond_init(&_cond,nullptr)==0,"semaphore condition init");
+}
+SemaphoreImpl::~SemaphoreImpl() {
+  guarantee(pthread_cond_destroy(&_cond)==0,"semaphore condition destroy");
+  guarantee(pthread_mutex_destroy(&_mutex)==0,"semaphore mutex destroy");
+}
+void SemaphoreImpl::signal(uint count) {
+  guarantee(pthread_mutex_lock(&_mutex)==0,"semaphore lock");
+  guarantee(UINT_MAX-_count>=count,"semaphore count overflow"); _count+=count;
+  guarantee(pthread_cond_broadcast(&_cond)==0,"semaphore signal");
+  guarantee(pthread_mutex_unlock(&_mutex)==0,"semaphore unlock");
+}
+void SemaphoreImpl::wait() {
+  guarantee(pthread_mutex_lock(&_mutex)==0,"semaphore lock");
+  while (_count==0) guarantee(pthread_cond_wait(&_cond,&_mutex)==0,"semaphore wait");
+  --_count;
+  guarantee(pthread_mutex_unlock(&_mutex)==0,"semaphore unlock");
+}
+bool SemaphoreImpl::trywait() {
+  guarantee(pthread_mutex_lock(&_mutex)==0,"semaphore lock");
+  bool ready=_count!=0; if (ready) --_count;
+  guarantee(pthread_mutex_unlock(&_mutex)==0,"semaphore unlock"); return ready;
+}
