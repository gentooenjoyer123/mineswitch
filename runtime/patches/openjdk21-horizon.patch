+bool os::dll_address_to_function_name(address addr,char* name,int len,int* offset,bool) {
+  bool found=false;
+  pthread_mutex_lock(&library_mutex);
+  for (size_t i=0;i<library_count && !found;i++) for (size_t j=0;j<libraries[i].count;j++)
+    if (addr==(address)libraries[i].symbols[j].address) {
+      jio_snprintf(name,len,"%s",libraries[i].symbols[j].name); if (offset) *offset=0; found=true; break;
+    }
+  pthread_mutex_unlock(&library_mutex);
+  if (!found) { if (len>0) name[0]=0; if (offset) *offset=-1; }
+  return found;
+}
+bool os::dll_address_to_library_name(address addr,char* name,int len,int* offset) {
+  bool found=false;
+  pthread_mutex_lock(&library_mutex);
+  for (size_t i=0;i<library_count && !found;i++) for (size_t j=0;j<libraries[i].count;j++)
+    if (addr==(address)libraries[i].symbols[j].address) {
+      jio_snprintf(name,len,"%s",libraries[i].name); if (offset) *offset=0; found=true; break;
