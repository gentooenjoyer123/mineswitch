+JNIEXPORT jlong JNICALL
+Java_com_sun_management_internal_OperatingSystemImpl_getOpenFileDescriptorCount0(JNIEnv *env, jobject self) {
+    (void)env; (void)self;
+    jlong count = 0;
+    /* __get_handle takes the pinned SDK's descriptor-table lock. We only test
+     * presence, never dereference a handle that another thread may close.
+     * Like /proc fd enumeration, the total is a sample during concurrent I/O.
