diff --git a/src/hotspot/os/horizon/horizon_bridge.c b/src/hotspot/os/horizon/horizon_bridge.c
new file mode 100644
index 000000000..5972c5d33
--- /dev/null
+++ b/src/hotspot/os/horizon/horizon_bridge.c
@@ -0,0 +1,136 @@
+/* C translation unit intentionally isolates libnx Thread/Mutex types. */
+#include "horizon_bridge.h"
+#include <switch.h>
+#include <malloc.h>
+#include <stdatomic.h>
+#include <stdio.h>
+uint64_t horizon_thread_id(void) {
+  u64 id=0; svcGetThreadId(&id,CUR_THREAD_HANDLE); return id;
+}
+uint64_t horizon_process_id(void) {
+  u64 id=0; svcGetProcessId(&id,CUR_PROCESS_HANDLE); return id;
+}
+unsigned horizon_thread_handle(void) { return threadGetCurHandle(); }
+int horizon_is_main_thread(void) {
+  u64 main_id=0;
+  return R_SUCCEEDED(svcGetThreadId(&main_id,envGetMainThreadHandle())) && main_id==horizon_thread_id();
+}
+int horizon_stack_region(void** bottom, size_t* size) {
+  Thread* self=threadGetSelf();
+  if (!self || !self->stack_mirror || !self->stack_sz) return -1;
+  *bottom=self->stack_mirror; *size=self->stack_sz; return 0;
+}
+int horizon_processor_count(void) {
+  u64 mask=0; if (R_FAILED(svcGetInfo(&mask,InfoType_CoreMask,CUR_PROCESS_HANDLE,0))) return 1;
+  int n=__builtin_popcountll(mask); return n?n:1;
+}
+unsigned horizon_processor_id(void) {
+  u64 mask=0; unsigned core=svcGetCurrentProcessorNumber();
+  if (R_FAILED(svcGetInfo(&mask,InfoType_CoreMask,CUR_PROCESS_HANDLE,0))) return 0;
+  return __builtin_popcountll(mask&((UINT64_C(1)<<core)-1));
+}
+
+uint64_t horizon_memory_limit(void) {
+  u64 n=0; svcGetInfo(&n,InfoType_TotalMemorySize,CUR_PROCESS_HANDLE,0); return n;
+}
+uint64_t horizon_memory_used(void) {
+  u64 n=0; svcGetInfo(&n,InfoType_UsedMemorySize,CUR_PROCESS_HANDLE,0); return n;
+}
+uint64_t horizon_memory_available(void) {
+  extern char* fake_heap_start;
+  extern char* fake_heap_end;
+  struct mallinfo mi=mallinfo();
+  uint64_t heap=(uintptr_t)fake_heap_end-(uintptr_t)fake_heap_start;
+  uint64_t free_heap=heap>mi.uordblks?heap-mi.uordblks:0;
+  uint64_t limit=horizon_memory_limit(),used=horizon_memory_used();
+  return free_heap+(limit>used?limit-used:0);
+}
+int horizon_thread_set_priority(unsigned handle, int priority) {
+  return R_SUCCEEDED(svcSetThreadPriority(handle,priority))?0:-1;
+}
+int horizon_thread_get_priority(unsigned handle, int* priority) {
+  s32 p=0; Result r=svcGetThreadPriority(&p,handle); if (R_FAILED(r)) return -1;
+  *priority=p; return 0;
+}
+void horizon_sleep_ns(int64_t nanoseconds) { svcSleepThread(nanoseconds); }
+int horizon_memory_readable(const void* address, size_t size) {
+  uintptr_t begin=(uintptr_t)address, end=begin+size;
+  if (end<begin) return 0;
+  while (begin<end) {
+    MemoryInfo mi; u32 pi;
+    if (R_FAILED(svcQueryMemory(&mi,&pi,begin)) || !(mi.perm&Perm_R)) return 0;
+    uintptr_t next=mi.addr+mi.size;
+    if (next<=begin) return 0;
+    begin=next;
+  }
+  return 1;
+}
+const char* horizon_firmware_version(void) { return "Horizon (libnx)"; }
+
+static atomic_flag horizon_exit_started = ATOMIC_FLAG_INIT;
+extern void horizon_native_exit_flush(void) __attribute__((weak));
+
+static void horizon_exit_flush(void) {
+  if (horizon_native_exit_flush) horizon_native_exit_flush();
+  else svcSleepThread(100000000);
+}
+
+static __attribute__((noreturn)) void horizon_wait_for_applet_termination(void) {
+  // This is libnx's accepted self-exit behavior: AM terminates the complete
+  // process. Keep all service handles, native code and daemon storage alive.
+  for (;;) svcSleepThread(1000000000);
+}
+
+void horizon_exit_process(int status, int report) {
+  // os::exit and the supervisor may arrive concurrently. A second caller must
+  // not race an accepted AM request with another IPC or svcExitProcess.
+  if (atomic_flag_test_and_set_explicit(&horizon_exit_started,memory_order_acq_rel))
+    horizon_wait_for_applet_termination();
+  if (report) fprintf(stderr,"HORIZON_PROCESS_EXIT status=%d\n",status);
+
+  AppletType type=appletGetAppletType();
+  Service* endpoint=NULL;
+  u32 command=0;
+  const char* kind="unavailable";
+  if (type==AppletType_Application || type==AppletType_SystemApplication) {
+    endpoint=appletGetServiceSession_SelfController();
+    command=0; // ISelfController::Exit, same command as libnx _appletSelfExit.
+    kind="application";
+  } else if (type==AppletType_LibraryApplet) {
+    endpoint=appletGetServiceSession_LibraryAppletSelfAccessor();
+    command=10; // ILibraryAppletSelfAccessor::ExitProcessAndReturn.
+    kind="library-applet";
+  }
+
+  // A C exit status is not a packed Horizon Result. Only explicitly publish
+  // success for clean status zero; retain nonzero status in the diagnostics.
+  bool result_set=status==0;
+  Result terminate_result=result_set ? appletSetTerminateResult(0) : 0;
+  if (report) {
+    fprintf(stderr,"HORIZON_APPLET_EXIT_REQUEST status=%d type=%d kind=%s command=%u result_set=%d result_rc=0x%08x\n",
+            status,(int)type,kind,command,result_set,terminate_result);
+    horizon_exit_flush();
+  }
+
+  Result result=MAKERESULT(Module_Libnx,LibnxError_NotInitialized);
+  if (endpoint && serviceIsActive(endpoint)) {
+    // Use the public session getter and the exact SDK command, without
+    // appletExit/__appExit/atexit cleanup or a return into the NRO loader.
+    Service request=*endpoint;
+    serviceAssumeDomain(&request);
+    result=serviceDispatch(&request,command);
+  }
+  if (R_SUCCEEDED(result)) {
+    if (report) {
+      fprintf(stderr,"HORIZON_APPLET_EXIT_ACCEPTED status=%d mode=manager\n",status);
+      horizon_exit_flush();
+    }
+    horizon_wait_for_applet_termination();
+  }
+
+  if (report) {
+    fprintf(stderr,"HORIZON_APPLET_EXIT_FAILED status=%d rc=0x%08x fallback=svcExitProcess\n",status,result);
+    horizon_exit_flush();
+  }
+  svcExitProcess();
+}
