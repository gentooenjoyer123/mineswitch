+
+/** Java's logical slash-root is the launcher's default sdmc device. */
+final class HorizonFileSystem extends UnixFileSystem {
+    HorizonFileSystem(UnixFileSystemProvider provider, String directory) {
+        super(provider, directory);
+    }
+
+    @Override public WatchService newWatchService() throws IOException {
+        return new PollingWatchService();
+    }
+
+    @Override public Set<String> supportedFileAttributeViews() {
+        return Set.of("basic");
+    }
+
+    @Override void copyNonPosixAttributes(int source, int destination) {
+        // This filesystem exposes no additional extended attribute view.
+    }
+
+    @Override Iterable<UnixMountEntry> getMountEntries() {
+        return List.of(new UnixMountEntry(Util.toBytes("sdmc"), Util.toBytes("/"),
+                Util.toBytes("horizon"), new byte[0], 0));
+    }
+
+    @Override FileStore getFileStore(UnixMountEntry entry) throws IOException {
+        return new HorizonFileStore(new UnixPath(this, entry.dir()));
+    }
+}
