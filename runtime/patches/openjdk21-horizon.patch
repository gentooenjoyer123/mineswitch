+Java_sun_nio_ch_UnixDispatcher_preClose0(JNIEnv *env, jclass clazz, jobject fdo) {
+    JNU_ThrowByName(env, "java/lang/UnsupportedOperationException", "Horizon native IO signalling/preclose is not implemented");
+}
