+#include "precompiled.hpp"
+#include "runtime/os.hpp"
+#include "utilities/vmError.hpp"
+// Horizon native fault dispatch will be installed by the NRO bridge. HotSpot
+// diagnostics do not register fictitious POSIX signal handlers.
+const void* VMError::crash_handler_address=nullptr;
+void VMError::reporting_started() {}
+void VMError::install_secondary_signal_handler() {}
+void VMError::check_failing_cds_access(outputStream*,const void*) {}
+void VMError::interrupt_reporting_thread() {
+  // There is no signal with which to interrupt a blocked reporter. The error
+  // watchdog terminates the process rather than waiting forever.
+  os::_exit(1);
+}
