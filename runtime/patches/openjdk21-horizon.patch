+public final class HorizonFileSystemProvider extends UnixFileSystemProvider {
+    @Override HorizonFileSystem newFileSystem(String directory) {
+        return new HorizonFileSystem(this, directory);
+    }
+
+    @Override HorizonFileStore getFileStore(UnixPath path) throws IOException {
+        return new HorizonFileStore(path);
+    }
+
+    @Override public <V extends FileAttributeView> V getFileAttributeView(
+            Path path, Class<V> type, LinkOption... options) {
+        Objects.requireNonNull(type);
+        return type == BasicFileAttributeView.class
+                ? super.getFileAttributeView(path, type, options) : null;
+    }
+
+    @Override protected DynamicFileAttributeView getFileAttributeView(
+            Path path, String name, LinkOption... options) {
+        return "basic".equals(name) ? super.getFileAttributeView(path, name, options) : null;
+    }
+
+    @Override public <A extends BasicFileAttributes> A readAttributes(
+            Path path, Class<A> type, LinkOption... options) throws IOException {
+        Objects.requireNonNull(type);
+        if (type != BasicFileAttributes.class) {
+            throw new UnsupportedOperationException("Horizon exposes basic file attributes only");
+        }
+        return super.readAttributes(path, type, options);
+    }
+}
