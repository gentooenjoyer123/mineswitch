+
+#ifdef HORIZON
+/* Horizon's BSD socket service exposes the BSD ioctl ABI through libnx.
+ * Read the actual kernel interface list instead of inventing an interface. */
+static char *horizon_ifconf(JNIEnv *env, int sock, int *length) {
+    for (size_t capacity = 4096; capacity <= 1024 * 1024; capacity *= 2) {
+        char *buffer = (char *)malloc(capacity);
+        if (buffer == NULL) {
+            JNU_ThrowOutOfMemoryError(env, "network interface buffer");
+            return NULL;
+        }
+        struct ifconf config;
+        memset(&config, 0, sizeof(config));
+        config.ifc_len = (int)capacity;
+        config.ifc_buf = buffer;
+        if (ioctl(sock, SIOCGIFCONF, &config) < 0) {
+            free(buffer);
+            JNU_ThrowByNameWithMessageAndLastError(env, "java/net/SocketException", "SIOCGIFCONF");
+            return NULL;
+        }
+        if (config.ifc_len >= 0 && (size_t)config.ifc_len + sizeof(struct ifreq) < capacity) {
+            *length = config.ifc_len;
+            return buffer;
+        }
+        free(buffer);
+    }
+    JNU_ThrowByName(env, "java/net/SocketException", "Network interface list exceeds supported size");
+    return NULL;
+}
+
+static int openSocketWithFallback(JNIEnv *env, const char *ifname) {
+    return openSocket(env, AF_INET);
+}
+
+static netif *enumIPv4Interfaces(JNIEnv *env, int sock, netif *ifs) {
+    int length = 0;
+    char *buffer = horizon_ifconf(env, sock, &length);
+    if (buffer == NULL) return ifs;
+    for (size_t offset = 0; offset + sizeof(struct ifreq) <= (size_t)length;) {
+        struct ifreq *entry = (struct ifreq *)(buffer + offset);
+        size_t stride = _SIZEOF_ADDR_IFREQ(*entry);
+        if (stride < sizeof(struct ifreq) || stride > (size_t)length - offset) {
+            JNU_ThrowByName(env, "java/net/SocketException", "Malformed kernel interface list");
+            break;
+        }
+        offset += stride;
+        if (entry->ifr_addr.sa_family != AF_INET) continue;
+        entry->ifr_name[sizeof(entry->ifr_name) - 1] = 0;
+        struct sockaddr address = entry->ifr_addr, broadcast;
+        struct sockaddr *broadcast_ptr = NULL;
+        struct ifreq query = *entry;
+        if (ioctl(sock, SIOCGIFFLAGS, &query) == 0 && (query.ifr_flags & IFF_BROADCAST)) {
+            query = *entry;
+            if (ioctl(sock, SIOCGIFBRDADDR, &query) == 0) {
+                broadcast = query.ifr_broadaddr;
+                broadcast_ptr = &broadcast;
+            }
+        }
+        short prefix = 0;
+        query = *entry;
+        if (ioctl(sock, SIOCGIFNETMASK, &query) == 0)
+            prefix = translateIPv4AddressToPrefix((struct sockaddr_in *)&query.ifr_addr);
+        ifs = addif(env, sock, entry->ifr_name, ifs, &address, broadcast_ptr, AF_INET, prefix);
+        if ((*env)->ExceptionCheck(env)) break;
+    }
+    free(buffer);
+    return ifs;
+}
+
+static netif *enumIPv6Interfaces(JNIEnv *env, int sock, netif *ifs) {
+    JNU_ThrowByName(env, "java/lang/UnsupportedOperationException", "Horizon IPv6 interfaces are unavailable");
+    return ifs;
+}
+
+static int getIndex(int sock, const char *name) {
+    struct ifreq query;
+    memset(&query, 0, sizeof(query));
+    strncpy(query.ifr_name, name, sizeof(query.ifr_name) - 1);
+    if (ioctl(sock, SIOCGIFINDEX, &query) < 0) return -1;
+    return (unsigned short)query.ifr_index;
+}
+
+static int getFlags(int sock, const char *name, int *flags) {
+    struct ifreq query;
+    memset(&query, 0, sizeof(query));
+    strncpy(query.ifr_name, name, sizeof(query.ifr_name) - 1);
+    if (ioctl(sock, SIOCGIFFLAGS, &query) < 0) return -1;
+    *flags = (unsigned short)query.ifr_flags;
+    return 0;
+}
+
+static int getMTU(JNIEnv *env, int sock, const char *name) {
+    struct ifreq query;
+    memset(&query, 0, sizeof(query));
+    strncpy(query.ifr_name, name, sizeof(query.ifr_name) - 1);
+    if (ioctl(sock, SIOCGIFMTU, &query) < 0) {
+        JNU_ThrowByNameWithMessageAndLastError(env, "java/net/SocketException", "SIOCGIFMTU");
+        return -1;
+    }
+    return query.ifr_mtu;
+}
+
+static int getMacAddress(JNIEnv *env, const char *name, const struct in_addr *address, unsigned char *out) {
+    int sock = openSocket(env, AF_INET), length = 0, result = -1;
+    if (sock < 0) return -1;
+    char *buffer = horizon_ifconf(env, sock, &length);
+    if (buffer != NULL) {
+        for (size_t offset = 0; offset + sizeof(struct ifreq) <= (size_t)length;) {
+            struct ifreq *entry = (struct ifreq *)(buffer + offset);
+            size_t stride = _SIZEOF_ADDR_IFREQ(*entry);
+            if (stride < sizeof(struct ifreq) || stride > (size_t)length - offset) break;
+            offset += stride;
+            if (entry->ifr_addr.sa_family != AF_LINK || strncmp(entry->ifr_name, name, IFNAMSIZ) != 0) continue;
+            struct sockaddr_dl *link = (struct sockaddr_dl *)&entry->ifr_addr;
+            size_t used = offsetof(struct sockaddr_dl, sdl_data) + link->sdl_nlen + link->sdl_alen;
+            if (link->sdl_alen > 0 && link->sdl_alen <= 16 && used <= link->sdl_len) {
+                memcpy(out, LLADDR(link), link->sdl_alen);
+                result = link->sdl_alen;
+                break;
+            }
+        }
+        free(buffer);
+    }
+    close(sock);
+    return result;
+}
+#endif /* HORIZON */
