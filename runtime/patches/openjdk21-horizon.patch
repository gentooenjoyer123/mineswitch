+public final class FileKey {
+    private String canonicalPath;
+    private FileKey() { }
+
+    public static FileKey create(FileDescriptor fd) throws IOException {
+        FileKey key = new FileKey();
+        key.init(fd);
+        return key;
+    }
+    @Override public int hashCode() { return canonicalPath.hashCode(); }
+    @Override public boolean equals(Object other) {
+        return other == this || (other instanceof FileKey key && canonicalPath.equals(key.canonicalPath));
+    }
+    private native void init(FileDescriptor fd) throws IOException;
+    private static native void initIDs();
+    static { initIDs(); }
+}
