diff --git a/src/hotspot/os/horizon/os_horizon.cpp b/src/hotspot/os/horizon/os_horizon.cpp
new file mode 100644
index 000000000..fad89e9c8
--- /dev/null
+++ b/src/hotspot/os/horizon/os_horizon.cpp
@@ -0,0 +1,535 @@
+/*
+ * Copyright (c) 2026, MineSwitch contributors.
+ * This file is available under GNU GPL version 2 only, as published by the
+ * Free Software Foundation. See the LICENSE file of the OpenJDK source tree.
+ */
+#include "precompiled.hpp"
+#include "os_horizon.hpp"
+#include "horizon_file_io.h"
+#include "classfile/vmSymbols.hpp"
+#include "jvm.h"
+#include "jvmti.h"
+#include "memory/allocation.inline.hpp"
+#include "logging/log.hpp"
+#include "runtime/arguments.hpp"
+#include "runtime/globals.hpp"
+#include "runtime/java.hpp"
+#include "runtime/javaThread.hpp"
+#include "runtime/mutexLocker.hpp"
+#include "runtime/osThread.hpp"
+#include "runtime/thread.inline.hpp"
+#include "utilities/defaultStream.hpp"
+#include "utilities/events.hpp"
+#include "utilities/vmError.hpp"
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <locale.h>
+#include <pthread.h>
+#include <signal.h>
+#include "runtime/globals_extension.hpp"
+#ifndef ZERO
+#include "horizon_aarch64_context.h"
+#include "nx_memory.h"
+#endif
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+static jlong initial_time_count;
+
+// newlib does not implement detached libnx threads. Every JVM-created thread
+// remains joinable; this reaper owns its pthread object after call_run() ends.
+// This also avoids accessing a JavaThread after call_run may have deleted it.
+struct ThreadTicket {
+  Thread* thread;
+  pthread_t native;
+  ThreadTicket* next;
+};
+static pthread_mutex_t reaper_mutex=PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t reaper_cond=PTHREAD_COND_INITIALIZER;
+static ThreadTicket* finished_threads=nullptr;
+static pthread_t reaper_thread;
+static bool reaper_started=false;
+
+static void* reap_threads(void*) {
+  for (;;) {
+    guarantee(pthread_mutex_lock(&reaper_mutex)==0,"reaper lock");
+    while (!finished_threads)
+      guarantee(pthread_cond_wait(&reaper_cond,&reaper_mutex)==0,"reaper wait");
+    ThreadTicket* ticket=finished_threads;
+    finished_threads=ticket->next;
+    guarantee(pthread_mutex_unlock(&reaper_mutex)==0,"reaper unlock");
+    int r=pthread_join(ticket->native,nullptr);
+    guarantee(r==0,"pthread_join: %d",r);
+    os::free(ticket);
+  }
+  return nullptr;
+}
+
+static void* thread_native_entry(void* argument) {
+  ThreadTicket* ticket=(ThreadTicket*)argument;
+  Thread* thread=ticket->thread;
+  thread->record_stack_base_and_size();
+  thread->initialize_thread_current();
+  OSThread* osthread=thread->osthread();
+  osthread->set_thread_id(horizon_thread_id());
+  osthread->set_native_handle(horizon_thread_handle());
+#ifndef ZERO
+  if (horizon_aarch64_exception_thread_init() != 0 || !nxvm_stack_guard_prepare()) {
+    horizon_aarch64_exception_thread_exit();
+    log_warning(os,thread)("Horizon native stack preparation failed: errno=%d rc=0x%08x",errno,nxvm_last_result());
+    Monitor* sync=osthread->startThread_lock();
+    MutexLocker ml(sync,Mutex::_no_safepoint_check_flag);
+    osthread->set_state(ZOMBIE);
+    sync->notify_all();
+    return nullptr;
+  }
+#endif
+  os::setup_fpu();
+  {
+    Monitor* sync=osthread->startThread_lock();
+    MutexLocker ml(sync,Mutex::_no_safepoint_check_flag);
+    osthread->set_state(INITIALIZED);
+    sync->notify_all();
+    while (osthread->get_state()==INITIALIZED) sync->wait_without_safepoint_check();
+  }
+  thread->call_run();
+  // No access to thread/osthread after this point.
+#ifndef ZERO
+  guarantee(nxvm_stack_guard_cleanup(),"Cannot restore native thread stack mapping before exit");
+  horizon_aarch64_exception_thread_exit();
+#endif
+  guarantee(pthread_mutex_lock(&reaper_mutex)==0,"reaper lock");
+  ticket->next=finished_threads;
+  finished_threads=ticket;
+  guarantee(pthread_cond_signal(&reaper_cond)==0,"reaper signal");
+  guarantee(pthread_mutex_unlock(&reaper_mutex)==0,"reaper unlock");
+  return nullptr;
+}
+
+void os::init() {
+  OSInfo::set_vm_page_size(4096);
+  OSInfo::set_vm_allocation_granularity(4096);
+  _page_sizes.add(4096);
+  set_processor_count(horizon_processor_count());
+  horizon_sync_init();
+  initial_time_count=javaTimeNanos();
+}
+
+jint os::init_2() {
+  DEBUG_ONLY(os::set_mutex_init_done();)
+  if (set_minimum_stack_sizes()!=JNI_OK) return JNI_ERR;
+  // Signals, cross-process perf memory and NUMA do not exist in this port.
+  // Reject explicit requests; defaults are adjusted to actual capabilities.
+  if ((!FLAG_IS_DEFAULT(ReduceSignalUsage) && !ReduceSignalUsage) ||
+      (!FLAG_IS_DEFAULT(UsePerfData) && UsePerfData) ||
+      UseNUMA || UseNUMAInterleaving) {
+    jio_fprintf(defaultStream::error_stream(),
+      "Horizon requires -Xrs, -XX:-UsePerfData and no NUMA options\n");
+    return JNI_ERR;
+  }
+  FLAG_SET_ERGO(ReduceSignalUsage,true);
+  FLAG_SET_ERGO(UsePerfData,false);
+  FLAG_SET_ERGO(UseNUMA,false);
+  FLAG_SET_ERGO(UseNUMAInterleaving,false);
+  if (!reaper_started) {
+    pthread_attr_t attr;
+    int r=pthread_attr_init(&attr);
+    if (!r) r=pthread_attr_setstacksize(&attr,128*K);
+    if (!r) r=pthread_create(&reaper_thread,&attr,reap_threads,nullptr);
+    pthread_attr_destroy(&attr);
+    if (r) { jio_fprintf(defaultStream::error_stream(),"Horizon reaper: %d\n",r); return JNI_ERR; }
+    reaper_started=true;
+  }
+  return JNI_OK;
+}
+
+bool os::create_thread(Thread* thread,ThreadType type,size_t requested) {
+  assert(thread->osthread()==nullptr,"thread already has OS state");
+  OSThread* osthread=new(std::nothrow) OSThread();
+  if (!osthread) return false;
+  ThreadTicket* ticket=(ThreadTicket*)os::malloc(sizeof(ThreadTicket),mtThread);
+  if (ticket) memset(ticket,0,sizeof(*ticket));
+  if (!ticket) { delete osthread; return false; }
+  osthread->set_thread_type(type);
+  osthread->set_state(ALLOCATED);
+  thread->set_osthread(osthread);
+  ticket->thread=thread;
+  size_t size=requested;
+  if (!size) {
+    if (type==java_thread) size=JavaThread::stack_size_at_create();
+    else if (type==compiler_thread && CompilerThreadStackSize) size=CompilerThreadStackSize*K;
+    else if (type==vm_thread && VMThreadStackSize) size=VMThreadStackSize*K;
+    if (!size) size=1*M;
+  }
+  size=align_up(MAX2(size,(size_t)64*K),(size_t)4096);
+  pthread_attr_t attr;
+  int r=pthread_attr_init(&attr);
+  if (!r) r=pthread_attr_setstacksize(&attr,size);
+  if (!r) r=pthread_create(&ticket->native,&attr,thread_native_entry,ticket);
+  pthread_attr_destroy(&attr);
+  if (r) {
+    log_warning(os,thread)("Horizon pthread_create failed: %d (%s)",r,os::strerror(r));
+    thread->set_osthread(nullptr); delete osthread; os::free(ticket); return false;
+  }
+  osthread->set_pthread_id(ticket->native);
+  {
+    Monitor* sync=osthread->startThread_lock();
+    MutexLocker ml(sync,Mutex::_no_safepoint_check_flag);
+    while (osthread->get_state()==ALLOCATED) sync->wait_without_safepoint_check();
+  }
+  if (osthread->get_state()!=INITIALIZED) {
+    guarantee(pthread_join(ticket->native,nullptr)==0,"join failed native initialization");
+    thread->set_osthread(nullptr);
+    delete osthread;
+    os::free(ticket);
+    return false;
+  }
+  return true;
+}
