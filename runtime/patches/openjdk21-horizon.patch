+
+char* os::pd_reserve_memory(size_t bytes, bool executable) {
+  return (char*)nxvm_reserve(bytes, vm_allocation_granularity(), executable);
+}
+
+char* os::reserve_memory_aligned(size_t bytes, size_t alignment, bool executable) {
+  // Direct aligned allocation avoids temporarily backing alignment-sized slack.
+  char* result = (char*)nxvm_reserve(bytes, alignment, executable);
+  if (result != nullptr) {
+    MemTracker::record_virtual_memory_reserve((address)result, bytes, CALLER_PC);
+  }
+  return result;
+}
+
+char* os::pd_attempt_reserve_memory_at(char* addr, size_t bytes, bool executable) {
+  // newlib owns the heap address space; never overwrite another allocation.
+  errno = ENOTSUP;
+  return nullptr;
+}
+
+bool os::pd_commit_memory(char* addr, size_t bytes, bool executable) {
+  return nxvm_commit(addr, bytes, executable);
+}
+
+bool os::pd_commit_memory(char* addr, size_t bytes, size_t alignment_hint, bool executable) {
+  return pd_commit_memory(addr, bytes, executable);
+}
+
+void os::pd_commit_memory_or_exit(char* addr, size_t bytes, bool executable, const char* message) {
+  if (!pd_commit_memory(addr, bytes, executable)) {
+    vm_exit_out_of_memory(bytes, OOM_MMAP_ERROR, "%s (Horizon rc=0x%08x, errno=%d)",
+                          message, nxvm_last_result(), errno);
+  }
+}
+
+void os::pd_commit_memory_or_exit(char* addr, size_t bytes, size_t alignment_hint,
+                                  bool executable, const char* message) {
+  pd_commit_memory_or_exit(addr, bytes, executable, message);
+}
+
+bool os::pd_uncommit_memory(char* addr, size_t bytes, bool executable) {
+  if (executable) { errno = ENOTSUP; return false; }
+  // Revokes access and arranges zero-on-recommit; physical backing is retained.
+  return nxvm_uncommit(addr, bytes);
+}
+
+bool os::pd_release_memory(char* addr, size_t bytes) {
+  return nxvm_release(addr, bytes);
+}
+
+bool os::protect_memory(char* addr, size_t bytes, ProtType prot, bool is_committed) {
+  switch (prot) {
+    case MEM_PROT_NONE: return nxvm_protect(addr, bytes, NXVM_NONE);
+    case MEM_PROT_READ: return nxvm_protect(addr, bytes, NXVM_READ);
+    case MEM_PROT_RW:   return nxvm_protect(addr, bytes, NXVM_READ_WRITE);
+    case MEM_PROT_RWX:  errno = ENOTSUP; return false;
+    default:           ShouldNotReachHere(); return false;
+  }
+}
+
+bool os::guard_memory(char* addr, size_t bytes) {
+#ifndef ZERO
+  // Native callers guard owned thread stacks. Do not fall through to the
+  // generic allocator lock on failure, especially during exception dispatch.
+  return nxvm_protect_current_stack(addr, bytes, NXVM_NONE);
+#else
+  return nxvm_protect(addr, bytes, NXVM_NONE);
+#endif
+}
+
+bool os::unguard_memory(char* addr, size_t bytes) {
+#ifndef ZERO
+  return nxvm_protect_current_stack(addr, bytes, NXVM_READ_WRITE);
+#else
+  return nxvm_protect(addr, bytes, NXVM_READ_WRITE);
+#endif
+}
+
+bool os::pd_create_stack_guard_pages(char* addr, size_t bytes) {
+#ifndef ZERO
+  return nxvm_protect_current_stack(addr, bytes, NXVM_READ_WRITE);
+#else
+  // libnx thread stacks are not nxvm reservations. Zero uses explicit checks;
+  // native stack fault recovery is not implemented by this port.
+  errno = ENOTSUP;
+  return false;
+#endif
+}
+
+bool os::remove_stack_guard_pages(char* addr, size_t bytes) {
+#ifndef ZERO
+  return nxvm_protect_current_stack(addr, bytes, NXVM_READ_WRITE);
+#else
+  errno = ENOTSUP;
+  return false;
+#endif
+}
+
+void os::pd_free_memory(char* addr, size_t bytes, size_t alignment_hint) {
+  // Discard data without claiming to return physical memory to the kernel.
+  if (!nxvm_discard(addr, bytes)) {
+    log_warning(os)("Cannot discard Horizon memory: " PTR_FORMAT ", " SIZE_FORMAT
+                    " bytes (rc=0x%08x, errno=%d)", p2i(addr), bytes, nxvm_last_result(), errno);
+  }
+}
+
+void os::pd_realign_memory(char* addr, size_t bytes, size_t alignment_hint) {
+  // A placement hint only. Horizon's backend exposes 4 KiB pages.
+}
+
+size_t os::pd_pretouch_memory(void* first, void* last, size_t page_size) {
+  return page_size;
+}
+
+bool os::trim_native_heap(size_change_t* rss_change) { errno = ENOTSUP; return false; }
+
+void os::print_memory_mappings(char* addr, size_t bytes, outputStream* st) {
+  nxvm_memory_stats stats;
+  nxvm_get_memory_stats(&stats);
+  st->print_cr("Horizon nxvm totals (all reservations, not a kernel mapping list):");
+  st->print_cr("  reservations=" SIZE_FORMAT " reserved=" SIZE_FORMAT " committed=" SIZE_FORMAT
+               " eager_backing=" SIZE_FORMAT " bytes", stats.reservations, stats.reserved_bytes,
+               stats.committed_bytes, stats.backing_bytes);
+}
+
+void os::large_page_init() {
+  if (UseLargePages) {
+    warning("Large pages are not supported by the Horizon heap backend");
+    FLAG_SET_DEFAULT(UseLargePages, false);
+  }
+}
+size_t os::large_page_size() { return 0; }
+bool os::can_commit_large_page_memory() { return false; }
+bool os::can_execute_large_page_memory() { return false; }
+char* os::pd_reserve_memory_special(size_t bytes, size_t alignment, size_t page_size,
+                                    char* addr, bool executable) {
+#ifndef ZERO
+  if (executable && addr == nullptr && page_size == vm_page_size()) {
+    NxJitArena* arena = nxjit_create(bytes, alignment);
+    return arena == nullptr ? nullptr : (char*)nxjit_rw_address(arena);
+  }
+#endif
+  errno = ENOTSUP; return nullptr;
+}
+bool os::pd_release_memory_special(char* addr, size_t bytes) {
+#ifndef ZERO
+  if (nxjit_contains(addr, bytes)) return nxjit_release_memory(addr, bytes);
+#endif
+  errno = ENOTSUP; return false;
+}
+
+// Read immutable named VM data files through a private descriptor eagerly;
+// shared file-backed Java heap and replacement/fixed mappings are unsupported.
+char* os::pd_map_memory(int fd, const char* file_name, size_t file_offset,
+                        char* addr, size_t bytes, bool read_only, bool allow_exec) {
+  if (file_name == nullptr || addr != nullptr || allow_exec) { errno = ENOTSUP; return nullptr; }
+  return (char*)nxvm_map_file_private(file_name, file_offset, bytes, read_only);
+}
+
+char* os::pd_remap_memory(int fd, const char* file_name, size_t file_offset,
+                          char* addr, size_t bytes, bool read_only, bool allow_exec) {
+  errno = ENOTSUP;
+  return nullptr;
+}
+
+bool os::pd_unmap_memory(char* addr, size_t bytes) {
+  return nxvm_unmap_file(addr, bytes);
+}
+
+int os::create_file_for_heap(const char* dir) { errno = ENOTSUP; return -1; }
+char* os::map_memory_to_file(char* base, size_t bytes, int fd) { errno = ENOTSUP; return nullptr; }
+char* os::map_memory_to_file_aligned(size_t bytes, size_t alignment, int fd) { errno = ENOTSUP; return nullptr; }
+char* os::pd_attempt_map_memory_to_file_at(char* addr, size_t bytes, int fd) { errno = ENOTSUP; return nullptr; }
+char* os::replace_existing_mapping_with_file_mapping(char* base, size_t bytes, int fd) {
+  errno = ENOTSUP; return nullptr;
+}
+
+void os::numa_make_local(char* addr, size_t bytes, int group) {}
+void os::numa_make_global(char* addr, size_t bytes) {}
+size_t os::numa_get_groups_num() { return 1; }
+size_t os::numa_get_leaf_groups(int* ids, size_t size) {
+  if (size == 0) return 0;
+  ids[0] = 0;
+  return 1;
+}
