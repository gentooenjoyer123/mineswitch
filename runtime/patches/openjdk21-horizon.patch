+int os::open(const char* path,int flags,int mode) {
+  int fd;
+  do { fd=nxio_open(path,flags,mode); } while (fd<0 && errno==EINTR);
+  if (fd>=0) {
+    struct stat st;
+    if (nxio_fstat(fd,&st)!=0) { int e=errno; nxio_close(fd); errno=e; return -1; }
+    if (S_ISDIR(st.st_mode)) { nxio_close(fd); errno=EISDIR; return -1; }
+  }
+  return fd;
+}
