+ * 2 along with this work; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301 USA.
+ */
+
+#include <jni.h>
+#include "jni_util.h"
+#include <mbedtls/sha512.h>
+#include <mbedtls/platform_util.h>
+#include <stdint.h>
+#include <string.h>
+
+/*
+ * Only the SHA-512 compression primitive is native. SHA5 and DigestBase own
+ * initial values, padding, byte counts, buffering, truncation, reset and clone.
+ * SHA-384 and SHA-512/224,/256 use the same compression with their Java IVs.
+ *
+ * Copy bounded regions instead of holding a critical Java array through an
+ * arbitrarily large update. No Java heap pointer survives a JNI call, and
+ * other threads can reach safepoints between the small batches.
+ */
+JNIEXPORT jint JNICALL
+Java_sun_security_provider_SHA5_implCompressBlocksHorizon0(
+        JNIEnv *env, jclass cls, jbyteArray input, jint offset, jint limit,
+        jlongArray state) {
+    mbedtls_sha512_context context;
+    jlong words[8];
+    unsigned char blocks[8192];
+    jint cursor = offset;
+    jint remaining;
+    jlong byte_count;
+    jsize input_length;
+
+    (void)cls;
+    if (input == NULL || state == NULL) {
+        JNU_ThrowNullPointerException(env, "SHA5 input or state");
+        return offset;
+    }
+    if ((*env)->GetArrayLength(env, state) != 8) {
+        JNU_ThrowByName(env, "java/security/ProviderException",
+                       "Invalid SHA5 compression state");
+        return offset;
+    }
+    input_length = (*env)->GetArrayLength(env, input);
+    if (offset < 0 || offset > input_length) {
+        JNU_ThrowArrayIndexOutOfBoundsException(env, "SHA5 block offset");
+        return offset;
+    }
+    if (limit < offset) {
+        return offset;
+    }
+    /* limit is the inclusive upper bound on the start of a full block. */
+    byte_count = (((jlong)limit - offset) / 128 + 1) * 128;
+    if (byte_count > (jlong)input_length - offset) {
+        JNU_ThrowArrayIndexOutOfBoundsException(env, "SHA5 block range");
+        return offset;
+    }
+    remaining = (jint)byte_count;
+    (*env)->GetLongArrayRegion(env, state, 0, 8, words);
+    if ((*env)->ExceptionCheck(env)) {
+        mbedtls_platform_zeroize(words, sizeof(words));
+        return offset;
+    }
+    mbedtls_sha512_init(&context);
+    /* Preserve the bit pattern of Java's signed 64-bit state words. */
+    memcpy(context.state, words, sizeof(words));
+    while (remaining != 0) {
+        jint count = remaining > (jint)sizeof(blocks)
+                ? (jint)sizeof(blocks) : remaining;
+        (*env)->GetByteArrayRegion(env, input, cursor, count, (jbyte *)blocks);
+        if ((*env)->ExceptionCheck(env)) {
+            goto cleanup;
+        }
+        for (jint i = 0; i < count; i += 128) {
+            if (mbedtls_internal_sha512_process(&context, blocks + i) != 0) {
+                JNU_ThrowByName(env, "java/security/ProviderException",
+                               "SHA5 native block compression failed");
+                goto cleanup;
+            }
+        }
+        cursor += count;
+        remaining -= count;
+    }
+    memcpy(words, context.state, sizeof(words));
+    (*env)->SetLongArrayRegion(env, state, 0, 8, words);
+cleanup:
+    mbedtls_sha512_free(&context);
+    mbedtls_platform_zeroize(words, sizeof(words));
+    mbedtls_platform_zeroize(blocks, sizeof(blocks));
+    return cursor;
+}
