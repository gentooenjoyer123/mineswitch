+
+NOINLINE address os::current_stack_pointer() {
+  return (address)__builtin_frame_address(0);
+}
+
+char* os::non_memory_address_word() { return (char*)0xffffffffffff; }
+
+address os::fetch_frame_from_context(const void* raw, intptr_t** sp, intptr_t** fp) {
+  const HorizonAArch64Context* context = (const HorizonAArch64Context*)raw;
+  if (sp) *sp = context ? (intptr_t*)context->sp : nullptr;
+  if (fp) *fp = context ? (intptr_t*)context->x[29] : nullptr;
+  return context ? (address)context->pc : nullptr;
+}
+
+frame os::fetch_frame_from_context(const void* raw) {
+  if (raw == nullptr) return frame();
+  intptr_t* sp;
+  intptr_t* fp;
+  address pc = fetch_frame_from_context(raw, &sp, &fp);
+  if (!is_readable_pointer(pc)) return fetch_compiled_frame_from_context(raw);
+  return frame(sp, fp, pc);
+}
+
+frame os::fetch_compiled_frame_from_context(const void* raw) {
+  if (raw == nullptr) return frame();
+  const HorizonAArch64Context* context = (const HorizonAArch64Context*)raw;
+  return frame((intptr_t*)context->sp, (intptr_t*)context->x[29],
+               (address)(context->x[30] - NativeInstruction::instruction_size));
+}
+
+frame os::get_sender_for_C_frame(frame* fr) {
+  address pc = fr->sender_pc();
+  CodeBlob* cb = CodeCache::find_blob(pc);
+  bool use_codeblob = cb != nullptr && cb->frame_size() > 0;
+  assert(!use_codeblob || !Interpreter::contains(pc), "not an interpreter frame");
+  intptr_t* sender_sp = use_codeblob
+    ? fr->link() + frame::metadata_words - cb->frame_size() : fr->link();
+  return frame(sender_sp, sender_sp, fr->link(), pc, cb, true);
+}
+
+NOINLINE frame os::current_frame() {
+  intptr_t* fp = *(intptr_t**)__builtin_frame_address(0);
+  frame here((intptr_t*)current_stack_pointer(), fp,
+             CAST_FROM_FN_PTR(address, os::current_frame));
+  return os::is_first_C_frame(&here) ? frame() : os::get_sender_for_C_frame(&here);
+}
+
+size_t os::_compiler_thread_min_stack_allowed = 72*K;
+size_t os::_java_thread_min_stack_allowed = 72*K;
+size_t os::_vm_internal_thread_min_stack_allowed = 72*K;
+size_t os::_os_min_stack_allowed = 64*K;
+
+address os::current_stack_base() {
+  void* bottom;
+  size_t size;
+  guarantee(horizon_stack_region(&bottom, &size) == 0, "Cannot determine Horizon thread stack");
+  return (address)bottom + size;
+}
+
+size_t os::current_stack_size() {
+  void* bottom;
+  size_t size;
+  guarantee(horizon_stack_region(&bottom, &size) == 0, "Cannot determine Horizon thread stack");
+  return size;
+}
+
+void os::print_context(outputStream* st, const void* raw) {
+  if (raw == nullptr) return;
+  const HorizonAArch64Context* context = (const HorizonAArch64Context*)raw;
+  st->print_cr("Horizon own-thread exception registers:");
+  for (int i = 0; i < 31; ++i) st->print_cr("X%d=" INTPTR_FORMAT, i, context->x[i]);
+  st->print_cr("SP=" INTPTR_FORMAT " PC=" INTPTR_FORMAT " FAR=" INTPTR_FORMAT,
+                context->sp, context->pc, context->far);
+  st->print_cr("PSTATE=%08x ESR=%08x description=%08x",
+                context->pstate, context->esr, context->description);
+}
+
+void os::print_register_info(outputStream* st, const void* raw, int& continuation) {
+  if (raw == nullptr) return;
+  const HorizonAArch64Context* context = (const HorizonAArch64Context*)raw;
+  while (continuation >= 0 && continuation < 31) {
+    int index = continuation++;
+    st->print("X%-2d=", index);
+    print_location(st, context->x[index]);
+  }
+}
+
+void os::setup_fpu() {
+  // Java's round-to-nearest, gradual underflow and disabled FP traps.
+  uint64_t fpcr = 0;
+  __asm__ volatile("msr fpcr, %0" :: "r"(fpcr));
+}
+
+#ifndef PRODUCT
+void os::verify_stack_alignment() {
+  assert(((uintptr_t)current_stack_pointer() & (StackAlignmentInBytes-1)) == 0,
+         "incorrect stack alignment");
+}
+#endif
+
+int os::extra_bang_size_in_bytes() { return 0; }
+
+bool os::supports_map_sync() {
+  // Horizon mappings do not implement persistent-memory MAP_SYNC/DAX.
+  return false;
+}
+
+static bool frame_at_stack_bang(JavaThread* thread, address pc,
+                                const HorizonAArch64Context* context, frame* result) {
+  if (Interpreter::contains(pc)) {
+    *result = os::fetch_frame_from_context(context);
+    if (!result->is_first_java_frame()) *result = result->java_sender();
+  } else {
+    CodeBlob* cb = CodeCache::find_blob(pc);
+    if (cb == nullptr || !cb->is_nmethod() || cb->is_frame_complete_at(pc)) return false;
+    *result = os::fetch_compiled_frame_from_context(context);
+    if (!result->is_java_frame()) *result = result->java_sender();
+  }
+  return result->is_java_frame();
+}
+
+static bool handle_stack_fault(JavaThread* thread, address addr, address pc,
+                               HorizonAArch64Context* context, address* stub) {
+  StackOverflow* state = thread->stack_overflow_state();
+  if (state->in_stack_yellow_reserved_zone(addr)) {
+    if (thread->thread_state() == _thread_in_Java) {
+      if (!thread->is_vthread_mounted() && state->in_stack_reserved_zone(addr)) {
+        frame fr;
+        if (frame_at_stack_bang(thread, pc, context, &fr)) {
+          frame activation = SharedRuntime::look_for_reserved_stack_annotated_method(thread, fr);
+          if (activation.sp() != nullptr) {
+            state->disable_stack_reserved_zone();
+            state->set_reserved_stack_activation(activation.is_interpreted_frame()
+              ? (address)(activation.fp() + frame::interpreter_frame_initial_sp_offset)
+              : (address)activation.unextended_sp());
+            return true;
+          }
+        }
+      }
+      state->disable_stack_yellow_reserved_zone();
+      *stub = SharedRuntime::continuation_for_implicit_exception(thread, pc, SharedRuntime::STACK_OVERFLOW);
+    } else {
+      state->disable_stack_yellow_reserved_zone();
+      return true;
+    }
+  } else if (state->in_stack_red_zone(addr)) {
+    // A red-zone fault cannot be recovered as a Java exception.
+    state->disable_stack_red_zone();
+  }
+  return false;
+}
+
+extern "C" int horizon_aarch64_current_java_state() {
+  Thread* current = Thread::current_or_null();
+  return current != nullptr && current->is_Java_thread()
+      ? (int)JavaThread::cast(current)->thread_state() : -1;
+}
+
+static volatile uint64_t horizon_deopt_traps = 0;
+extern "C" uint64_t horizon_deopt_resume_count() {
+  return Atomic::load(&horizon_deopt_traps);
+}
+
+extern "C" int horizon_aarch64_handle_exception(HorizonAArch64Context* context) {
+  Thread* current = Thread::current_or_null();
+  if (current == nullptr || !current->is_Java_thread()) return 0;
+  JavaThread* thread = JavaThread::cast(current);
+  address pc = (address)context->pc;
+  address addr = (address)context->far;
+  unsigned exception_class = context->esr >> 26;
+  bool data_abort = exception_class == 0x24;
+  bool instruction_trap = exception_class == 0 || exception_class == 0x18 || exception_class == 0x3c;
+  address stub = nullptr;
+
+  // Match the shared POSIX handler's post-call NOP deoptimization protocol.
+  // Horizon never enters signals_posix.cpp. Returning to a patched nmethod
+  // therefore needs the original PC saved in its real frame before resuming
+  // that nmethod's deopt handler (including method-handle returns).
+  if (instruction_trap && thread->thread_state() == _thread_in_Java &&
+      os::is_readable_pointer(pc) && NativeDeoptInstruction::is_deopt_at(pc)) {
+    CodeBlob* cb = CodeCache::find_blob(pc);
+    if (cb != nullptr && cb->is_compiled()) {
+      CompiledMethod* cm = cb->as_compiled_method();
+      if (cm->insts_contains_inclusive(pc)) {
+        address deopt = cm->is_method_handle_return(pc)
+            ? cm->deopt_mh_handler_begin() : cm->deopt_handler_begin();
+        if (deopt != nullptr) {
+          frame fr = os::fetch_frame_from_context(context);
+          cm->set_original_pc(&fr, pc);
+          context->pc = (uintptr_t)deopt;
+          Atomic::inc(&horizon_deopt_traps);
+          return 1;
+        }
+      }
+    }
+  }
+
+  if (data_abort && thread->is_in_full_stack(addr)) {
+    if (handle_stack_fault(thread, addr, pc, context, &stub)) return 1;
+  }
+  if (stub == nullptr && thread->thread_state() == _thread_in_Java) {
+    if (instruction_trap && os::is_readable_pointer(pc) &&
+        nativeInstruction_at(pc)->is_sigill_not_entrant()) {
+      stub = SharedRuntime::get_handle_wrong_method_stub();
+    } else if (data_abort && SafepointMechanism::is_poll_address(addr)) {
+      stub = SharedRuntime::get_poll_stub(pc);
+    } else if (data_abort && MacroAssembler::uses_implicit_null_check(addr)) {
+      stub = SharedRuntime::continuation_for_implicit_exception(thread, pc, SharedRuntime::IMPLICIT_NULL);
+    }
+  }
+  if (stub == nullptr && data_abort) {
+    // A concurrent GC can invalidate a speculative fast JNI field read.
+    // Only the exact sites registered by the JNI fast-accessor generator
+    // are redirected to their real slow JNI implementations.
+    address slow = JNI_FastGetField::find_slowcase_pc(pc);
+    if (slow != (address)-1) stub = slow;
+  }
+  if (stub == nullptr) return 0;
+  thread->set_saved_exception_pc(pc);
+  context->pc = (uintptr_t)stub;
+  return 1;
+}
+
+extern "C" int SpinPause() {
+  __asm__ volatile("yield" ::: "memory");
+  return 1;
+}
+
+extern "C" void breakpoint() {
+  // A real AArch64 debug trap. Unknown traps are not resumed by the adapter.
+  __asm__ volatile("brk #0" ::: "memory");
+}
+
+template<class T> static void conjoint_atomic(const T* source, T* target, size_t count) {
+  if (count == 0 || source == target) return;
+  if ((uintptr_t)source > (uintptr_t)target) {
+    for (size_t i = 0; i < count; ++i) ((volatile T*)target)[i] = ((const volatile T*)source)[i];
+  } else {
+    while (count != 0) { --count; ((volatile T*)target)[count] = ((const volatile T*)source)[count]; }
+  }
+}
+extern "C" {
+void _Copy_conjoint_jshorts_atomic(const jshort* a, jshort* b, size_t n) { conjoint_atomic(a,b,n); }
+void _Copy_conjoint_jints_atomic(const jint* a, jint* b, size_t n) { conjoint_atomic(a,b,n); }
+void _Copy_conjoint_jlongs_atomic(const jlong* a, jlong* b, size_t n) { conjoint_atomic(a,b,n); }
+void _Copy_arrayof_conjoint_bytes(const HeapWord* a, HeapWord* b, size_t n) { memmove(b,a,n); }
+void _Copy_arrayof_conjoint_jshorts(const HeapWord* a, HeapWord* b, size_t n) { memmove(b,a,n*2); }
+void _Copy_arrayof_conjoint_jints(const HeapWord* a, HeapWord* b, size_t n) { memmove(b,a,n*4); }
+void _Copy_arrayof_conjoint_jlongs(const HeapWord* a, HeapWord* b, size_t n) { memmove(b,a,n*8); }
+}
