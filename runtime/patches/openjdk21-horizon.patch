+ *
+ * Please contact Oracle, 500 Oracle Parkway, Redwood Shores, CA 94065 USA
+ * or visit www.oracle.com if you need additional information or have any
+ * questions.
+ */
+
+#include <jni.h>
+#include "jni_util.h"
+#include "sun_security_provider_NativeSeedGenerator.h"
+#include <switch.h>
+
+JNIEXPORT jboolean JNICALL
+Java_sun_security_provider_NativeSeedGenerator_nativeGenerateSeed(JNIEnv* env,jclass cls,jbyteArray output) {
+    if (!output) { JNU_ThrowNullPointerException(env,"seed buffer"); return JNI_FALSE; }
+    jsize size=(*env)->GetArrayLength(env,output);
+    if (size==0) return JNI_TRUE;
+    if (R_FAILED(csrngInitialize())) return JNI_FALSE;
+    jbyte bytes[1024];
+    jboolean success=JNI_TRUE;
+    for (jsize offset=0;offset<size;) {
+        jsize count=size-offset;
+        if (count>(jsize)sizeof(bytes)) count=sizeof(bytes);
+        if (R_FAILED(csrngGetRandomBytes(bytes,(size_t)count))) { success=JNI_FALSE; break; }
+        (*env)->SetByteArrayRegion(env,output,offset,count,bytes);
+        if ((*env)->ExceptionCheck(env)) { success=JNI_FALSE; break; }
+        offset+=count;
+    }
+    volatile jbyte* wipe=bytes;
+    for (size_t i=0;i<sizeof(bytes);i++) wipe[i]=0;
+    csrngExit();
+    return success;
+}
