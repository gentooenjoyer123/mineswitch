+#include "jni_util.h"
+#include <switch.h>
+static jlong current_pid(void) {
+    u64 pid=0;
+    return R_SUCCEEDED(svcGetProcessId(&pid,CUR_PROCESS_HANDLE))?(jlong)pid:-1;
+}
+static void unsupported(JNIEnv* env,const char* message) {
+    JNU_ThrowByName(env,"java/lang/UnsupportedOperationException",message);
+}
+JNIEXPORT void JNICALL Java_java_lang_ProcessHandleImpl_initNative(JNIEnv* env,jclass cls) {}
+JNIEXPORT void JNICALL Java_java_lang_ProcessHandleImpl_00024Info_initIDs(JNIEnv* env,jclass cls) {}
+JNIEXPORT jlong JNICALL Java_java_lang_ProcessHandleImpl_getCurrentPid0(JNIEnv* env,jclass cls) {
+    return current_pid();
+}
+JNIEXPORT jint JNICALL Java_java_lang_ProcessHandleImpl_waitForProcessExit0(JNIEnv* env,jclass cls,jlong pid,jboolean reap) {
+    unsupported(env,"Waiting for another process is unavailable on Horizon"); return -1;
+}
+JNIEXPORT jboolean JNICALL Java_java_lang_ProcessHandleImpl_destroy0(JNIEnv* env,jobject self,jlong pid,jlong started,jboolean force) {
+    unsupported(env,"Terminating another process is unavailable on Horizon"); return JNI_FALSE;
+}
+JNIEXPORT jint JNICALL Java_java_lang_ProcessHandleImpl_getProcessPids0(JNIEnv* env,jclass cls,jlong pid,jlongArray children,jlongArray parents,jlongArray starts) {
+    unsupported(env,"Process enumeration is unavailable on Horizon"); return -1;
+}
+JNIEXPORT void JNICALL Java_java_lang_ProcessHandleImpl_00024Info_info0(JNIEnv* env,jobject self,jlong pid) {
+    if (pid!=current_pid()) unsupported(env,"Inspecting another process is unavailable on Horizon");
+    // Optional executable/user/start/CPU information is unavailable to this
+    // embedding. Java's initialized empty fields correctly express that.
+}
+JNIEXPORT jlong JNICALL Java_java_lang_ProcessHandleImpl_isAlive0(JNIEnv* env,jobject self,jlong pid) {
+    if (pid==current_pid()) return 0; // Alive, start timestamp unknown.
+    unsupported(env,"Inspecting another process is unavailable on Horizon"); return -1;
+}
+JNIEXPORT jlong JNICALL Java_java_lang_ProcessHandleImpl_parent0(JNIEnv* env,jobject self,jlong pid,jlong started) {
+    if (pid!=current_pid()) unsupported(env,"Inspecting another process is unavailable on Horizon");
+    return -1; // Horizon has no Unix parent relationship for this application.
+}
