@@ -0,0 +1,36 @@
+/* Horizon target capabilities: Nintendo Switch Tegra X1 / Cortex-A57.
+ * No Linux auxv, /proc, privileged ID-register read or SVE probing is used. */
+#include "precompiled.hpp"
+#include "runtime/os.hpp"
+#include "runtime/vm_version.hpp"
+#include "jvm_io.h"
+
+int VM_Version::get_current_sve_vector_length() {
+  return -1; // This target has no SVE execution state.
+}
+
+int VM_Version::set_and_get_current_sve_vector_length(int length) {
+  return -1;
+}
+
+void VM_Version::get_os_cpu_info() {
+  // These instructions are part of the documented Switch CPU target and
+  // already used by the devkitPro +crc+crypto libraries in this process.
+  _features = CPU_FP | CPU_ASIMD | CPU_AES | CPU_PMULL |
+              CPU_SHA1 | CPU_SHA2 | CPU_CRC32;
+  _cpu = CPU_ARM;
+  _model = 0xd07; // Cortex-A57, not a guessed MIDR from inaccessible registers.
+  _model2 = 0;
+  _variant = 0;
+  _revision = 0;
+  uint64_t ctr, dczid;
+  // libnx uses these same EL0-readable cache registers for its cache API.
+  __asm__ volatile("mrs %0, ctr_el0\n\tmrs %1, dczid_el0" : "=r"(ctr), "=r"(dczid));
+  _icache_line_size = 4 << (ctr & 15);
+  _dcache_line_size = 4 << ((ctr >> 16) & 15);
+  _zva_length = (dczid & 16) ? 0 : (4 << (dczid & 15));
+}
+
+void VM_Version::get_compatible_board(char* buffer, int length) {
+  jio_snprintf(buffer, length, "Nintendo Switch (Tegra X1)");
+}
