+import java.awt.peer.SystemTrayPeer;
+import java.awt.peer.TrayIconPeer;
+import java.util.Map;
+import java.util.Properties;
+
+/** The inherited image loading and event-queue implementations are unchanged.
+ * APIs requiring native AWT windows fail through the normal headless contract. */
+final class HorizonToolkit extends SunToolkit {
+    @Override public int getScreenResolution() { throw new HeadlessException(); }
+    @Override public Clipboard getSystemClipboard() { throw new HeadlessException(); }
+    @Override public PrintJob getPrintJob(Frame owner, String title, Properties properties) { throw new HeadlessException(); }
+    @Override public FramePeer createLightweightFrame(LightweightFrame frame) { throw new HeadlessException(); }
+    @Override public TrayIconPeer createTrayIcon(TrayIcon icon) { throw new HeadlessException(); }
+    @Override public SystemTrayPeer createSystemTray(SystemTray tray) { throw new HeadlessException(); }
+    @Override public KeyboardFocusManagerPeer getKeyboardFocusManagerPeer() { throw new HeadlessException(); }
+    @Override public boolean isTraySupported() { return false; }
+    @Override public boolean isDesktopSupported() { return false; }
+    @Override public boolean isTaskbarSupported() { return false; }
+    @Override public void grab(Window window) { throw new HeadlessException(); }
+    @Override public void ungrab(Window window) { throw new HeadlessException(); }
+    @Override public Map<TextAttribute, ?> mapInputMethodHighlight(InputMethodHighlight highlight) {
+        throw new HeadlessException();
+    }
+    @Override public InputMethodDescriptor getInputMethodAdapterDescriptor() throws AWTException {
+        throw new AWTException("Horizon AWT native input methods are unavailable");
+    }
+    @Override public boolean enableInputMethodsForTextComponent() { return false; }
+    @Override public void beep() { throw new UnsupportedOperationException("Horizon AWT beep is unavailable"); }
+    // Software image operations are synchronous, with no native AWT event queue.
+    @Override public void sync() {}
+    @Override protected boolean syncNativeQueue(long timeout) { return false; }
+}
