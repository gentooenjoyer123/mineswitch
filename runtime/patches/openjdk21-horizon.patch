diff --git a/src/java.base/horizon/native/libjimage/osSupport_horizon.cpp b/src/java.base/horizon/native/libjimage/osSupport_horizon.cpp
new file mode 100644
index 000000000..75ac82b18
--- /dev/null
+++ b/src/java.base/horizon/native/libjimage/osSupport_horizon.cpp
@@ -0,0 +1,182 @@
+/*
+ * Copyright (c) 2026, MineSwitch contributors. All rights reserved.
+ *
+ * This code is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 2 only, as
+ * published by the Free Software Foundation. This particular file is
+ * subject to the "Classpath" exception as provided in the LICENSE file
+ * that accompanied this code.
+ *
+ * This code is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License
+ * version 2 for more details.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "jni.h"
+#include "osSupport.hpp"
+#include "nx_memory.h"
+
+namespace {
+
+// These descriptors are exclusively owned by libjimage. They are never exposed
+// as Java file descriptors, duplicated, or used outside the osSupport methods.
+// newlib has no pread implementation. A lock per private descriptor serializes
+// seek/read/restore and close, preserving positioned reads on the same image.
+struct ImageFileHandle {
+    int descriptor;
+    pthread_mutex_t io_lock;
+    ImageFileHandle* next;
+};
+
+pthread_mutex_t handle_list_lock = PTHREAD_MUTEX_INITIALIZER;
+ImageFileHandle* handles;
+
+void checked_lock(pthread_mutex_t* mutex) {
+    if (pthread_mutex_lock(mutex) != 0) abort();
+}
+
+void checked_unlock(pthread_mutex_t* mutex) {
+    if (pthread_mutex_unlock(mutex) != 0) abort();
+}
+
+// Holds io_lock when successful. Acquiring io_lock before releasing list_lock
+// makes the descriptor's lifetime stable against concurrent close. A read never
+// reacquires list_lock while holding io_lock, so the lock order cannot invert.
+ImageFileHandle* acquire_handle(int descriptor) {
+    checked_lock(&handle_list_lock);
+    ImageFileHandle* handle = handles;
+    while (handle != NULL && handle->descriptor != descriptor) handle = handle->next;
+    if (handle != NULL) checked_lock(&handle->io_lock);
+    checked_unlock(&handle_list_lock);
+    if (handle == NULL) errno = EBADF;
+    return handle;
+}
+
+} // namespace
+
+jint osSupport::openReadOnly(const char* path) {
+    int fd = ::open(path, O_RDONLY);
+    if (fd < 0) return -1;
+    struct stat info;
+    int stat_result = fstat(fd, &info);
+    if (stat_result != 0 || !S_ISREG(info.st_mode)) {
+        int saved_errno = errno;
+        if (stat_result == 0) saved_errno = EINVAL;
+        ::close(fd);
+        errno = saved_errno;
+        return -1;
+    }
+    ImageFileHandle* handle = (ImageFileHandle*)malloc(sizeof(ImageFileHandle));
+    if (handle == NULL) { ::close(fd); errno = ENOMEM; return -1; }
+    int error = pthread_mutex_init(&handle->io_lock, NULL);
+    if (error != 0) { free(handle); ::close(fd); errno = error; return -1; }
+    handle->descriptor = fd;
+    checked_lock(&handle_list_lock);
+    handle->next = handles;
+    handles = handle;
+    checked_unlock(&handle_list_lock);
+    return fd;
+}
+
+jint osSupport::close(jint fd) {
+    checked_lock(&handle_list_lock);
+    ImageFileHandle** link = &handles;
+    while (*link != NULL && (*link)->descriptor != fd) link = &(*link)->next;
+    ImageFileHandle* handle = *link;
+    if (handle == NULL) {
+        checked_unlock(&handle_list_lock);
+        errno = EBADF;
+        return -1;
+    }
+    checked_lock(&handle->io_lock);
+    *link = handle->next;
+    checked_unlock(&handle_list_lock);
+    int result = ::close(fd);
+    int saved_errno = errno;
+    checked_unlock(&handle->io_lock);
+    if (pthread_mutex_destroy(&handle->io_lock) != 0) abort();
+    free(handle);
+    errno = saved_errno;
+    return result;
+}
+
+jlong osSupport::size(const char* path) {
+    struct stat info;
+    if (::stat(path, &info) != 0 || !S_ISREG(info.st_mode)) return -1;
+    return (jlong)info.st_size;
+}
+
+jlong osSupport::read(jint fd, char* buffer, jlong bytes, jlong offset) {
+    if (bytes < 0 || offset < 0 || bytes > INT64_MAX - offset ||
+        (buffer == NULL && bytes != 0)) { errno = EINVAL; return -1; }
+    ImageFileHandle* handle = acquire_handle(fd);
+    if (handle == NULL) return -1;
+    off_t original = ::lseek(fd, 0, SEEK_CUR);
+    if (original < 0 || ::lseek(fd, (off_t)offset, SEEK_SET) < 0) {
+        int saved_errno = errno;
+        checked_unlock(&handle->io_lock);
+        errno = saved_errno;
+        return -1;
+    }
+    jlong done = 0;
+    int read_error = 0;
+    while (done < bytes) {
+        size_t count = (size_t)(bytes - done);
+        if (count > INT_MAX) count = INT_MAX;
+        ssize_t result = ::read(fd, buffer + done, count);
+        if (result < 0 && errno == EINTR) continue;
+        if (result < 0) { read_error = errno; break; }
+        if (result == 0) break;
+        done += result;
+    }
+    if (::lseek(fd, original, SEEK_SET) < 0) {
+        done = -1;
+        read_error = errno;
+    } else if (read_error != 0 && done == 0) {
+        done = -1;
+    }
+    checked_unlock(&handle->io_lock);
+    if (read_error != 0) errno = read_error;
+    return done;
+}
+
+void* osSupport::map_memory(jint fd, const char* filename, size_t offset, size_t bytes) {
+    if (bytes == 0 || bytes > SIZE_MAX - (NXVM_PAGE_SIZE - 1) ||
+        offset > INT64_MAX || bytes > INT64_MAX - offset) { errno = EINVAL; return NULL; }
+    size_t rounded = (bytes + NXVM_PAGE_SIZE - 1) & ~(size_t)(NXVM_PAGE_SIZE - 1);
+    void* memory = nxvm_reserve(rounded, NXVM_PAGE_SIZE, false);
+    if (memory == NULL) return NULL;
+    bool success = nxvm_commit(memory, rounded, false);
+    if (success) {
+        jlong count = osSupport::read(fd, (char*)memory, bytes, offset);
+        success = count == (jlong)bytes;
+        if (!success && count >= 0) errno = EIO;
+    }
+    if (success) success = nxvm_protect(memory, rounded, NXVM_READ);
+    if (!success) {
+        int saved_errno = errno;
+        if (!nxvm_release(memory, rounded)) abort();
+        errno = saved_errno;
+        return NULL;
+    }
+    return memory;
+}
+
+int osSupport::unmap_memory(void* address, size_t bytes) {
+    return nxvm_unmap_file(address, bytes) ? 1 : 0;
+}
+
+void SimpleCriticalSection::enter() { checked_lock(&mutex); }
+void SimpleCriticalSection::exit() { checked_unlock(&mutex); }
+SimpleCriticalSection::SimpleCriticalSection() {
+    if (pthread_mutex_init(&mutex, NULL) != 0) abort();
+}
