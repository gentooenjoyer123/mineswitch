+}
+
+JNIEXPORT void JNICALL
+Java_sun_nio_ch_UnixDispatcher_close0(JNIEnv *env, jclass clazz, jobject fdo) {
+    int fd = fdval(env, fdo);
+    if (fd >= 0) {
+        /* NativeThread reports no POSIX signals. Shutdown releases an active
+         * connected TCP receive before descriptor reuse; verified on device.
+         * A shutdown failure never prevents closing the owned descriptor. */
+        (void)shutdown(fd, SHUT_RDWR);
+        if (nxio_close(fd) != 0) JNU_ThrowIOExceptionWithLastError(env, "Close failed");
+    }
+}
