--- /dev/null
+++ b/src/java.base/horizon/native/libnio/ch/horizon_socket_io.c
@@ -0,0 +1,48 @@
+/* Copyright (c) 2026 MineSwitch contributors. GPL-2.0-only WITH Classpath-exception-2.0 */
+#include "horizon_socket_io.h"
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+
+/* One socket operation preserves UDP message boundaries and avoids blocking a
+ * stream read again after some data has already arrived in an earlier vector.
+ * TCP is allowed to return a short transfer. IPv4 datagrams cannot exceed the
+ * 64 KiB receive allocation even when the caller supplies a larger vector. */
+ssize_t horizon_socket_vector(int fd, const struct iovec *vectors, int count, int writing, int datagram) {
+    if (count < 0 || count > 1024 || (count && !vectors)) { errno = EINVAL; return -1; }
+    size_t total = 0;
+    for (int i = 0; i < count; ++i) {
+        if (vectors[i].iov_len > INT64_MAX - total) { errno = EINVAL; return -1; }
+        total += vectors[i].iov_len;
+    }
+    if (!total) return 0;
+    size_t limit = datagram ? 65536 : 1024 * 1024;
+    if (writing && datagram && total > 65507) { errno = EMSGSIZE; return -1; }
+    size_t length = total < limit ? total : limit;
+    unsigned char *buffer = malloc(length);
+    if (!buffer) { errno = ENOMEM; return -1; }
+    size_t position = 0;
+    if (writing) {
+        for (int i = 0; i < count && position < length; ++i) {
+            size_t size = vectors[i].iov_len;
+            if (size > length - position) size = length - position;
+            memcpy(buffer + position, vectors[i].iov_base, size);
+            position += size;
+        }
+    }
+    ssize_t result = writing ? send(fd, buffer, length, 0) : recv(fd, buffer, length, 0);
+    int error = errno;
+    if (!writing && result > 0) {
+        for (int i = 0; i < count && position < (size_t)result; ++i) {
+            size_t size = vectors[i].iov_len;
+            if (size > (size_t)result - position) size = (size_t)result - position;
+            memcpy(vectors[i].iov_base, buffer + position, size);
+            position += size;
+        }
+    }
+    free(buffer);
+    errno = error;
+    return result;
+}
