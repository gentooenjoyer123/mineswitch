+#include <sys/types.h>
+#include <string.h>
+#include <limits.h>
+#include <switch/kernel/random.h>
+#include "horizon_file_io.h"
+#include "horizon_pipe.h"
+#define read nxio_read
+#define write nxio_write
+#define close nxio_close
+
+#include "jni.h"
