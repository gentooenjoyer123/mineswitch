+// Registered static JNI libraries replace ELF dlopen/dlsym. No unregistered
+// library is reported loaded: callers receive an explicit unsupported error.
+struct StaticLibrary { const char* name; const HorizonNativeSymbol* symbols; size_t count; };
+static StaticLibrary libraries[64];
+static size_t library_count=0;
+static char process_handle;
+static pthread_mutex_t library_mutex=PTHREAD_MUTEX_INITIALIZER;
+extern "C" int horizon_register_native_library(const char* name,const HorizonNativeSymbol* symbols,size_t count) {
+  if (!name || (!symbols && count)) return EINVAL;
+  pthread_mutex_lock(&library_mutex);
+  if (library_count==ARRAY_SIZE(libraries)) { pthread_mutex_unlock(&library_mutex); return ENOSPC; }
+  for (size_t i=0;i<library_count;i++) if (!strcmp(name,libraries[i].name)) {
+    pthread_mutex_unlock(&library_mutex); return EEXIST;
+  }
+  libraries[library_count++]={name,symbols,count};
+  pthread_mutex_unlock(&library_mutex); return 0;
+}
+extern "C" int horizon_has_native_library(const char* name) {
+  if (!name) return 0;
+  int found=0;
+  pthread_mutex_lock(&library_mutex);
+  for (size_t i=0;i<library_count;i++) if (!strcmp(name,libraries[i].name)) { found=1; break; }
+  pthread_mutex_unlock(&library_mutex);
+  return found;
+}
+extern "C" void* horizon_process_library_handle() { return &process_handle; }
+void* os::get_default_process_handle() { return &process_handle; }
+void* os::dll_lookup(void* handle,const char* name) {
+  void* result=nullptr;
+  pthread_mutex_lock(&library_mutex);
+  for (size_t i=0;i<library_count && !result;i++) {
+    if (handle!=&process_handle && handle!=&libraries[i]) continue;
+    for (size_t j=0;j<libraries[i].count;j++) if (!strcmp(name,libraries[i].symbols[j].name)) {
+      result=libraries[i].symbols[j].address; break;
+    }
+  }
+  pthread_mutex_unlock(&library_mutex); return result;
+}
+void* os::dll_load(const char* name,char* error,int error_len) {
+  const char* basename=strrchr(name,'/'); basename=basename?basename+1:name;
+  char canonical[128]; jio_snprintf(canonical,sizeof(canonical),"%s",basename);
+  char* shortname=canonical; if (!strncmp(shortname,"lib",3)) shortname+=3;
+  char* dot=strrchr(shortname,'.'); if (dot && (!strcmp(dot,".so") || !strcmp(dot,".a"))) *dot=0;
+  void* result=nullptr;
+  pthread_mutex_lock(&library_mutex);
+  for (size_t i=0;i<library_count;i++) if (!strcmp(shortname,libraries[i].name)) { result=&libraries[i]; break; }
+  pthread_mutex_unlock(&library_mutex);
+  if (!result && error_len>0) jio_snprintf(error,error_len,"Horizon: native library '%s' is not statically registered",name);
+  return result;
+}
