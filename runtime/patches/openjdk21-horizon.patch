+int os::numa_get_group_id() { return 0; }
+int os::numa_get_group_id_for_address(const void* address) { return 0; }
+bool os::numa_get_group_ids_for_range(const void** addresses, int* ids, size_t count) {
+  for (size_t i = 0; i < count; ++i) ids[i] = 0;
+  return true;
+}
