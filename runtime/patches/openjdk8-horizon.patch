+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_DatagramDispatcher_read0(JNIEnv *env, jclass clazz,
+                                         jobject fdo, jlong address, jint len)
+{
+    jint fd = fdval(env, fdo);
+    void *buf = (void *)jlong_to_ptr(address);
+    int result = recv(fd, buf, len, 0);
+    if (result < 0 && errno == ECONNREFUSED) {
+        JNU_ThrowByName(env, JNU_JAVANETPKG "PortUnreachableException", 0);
+        return IOS_THROWN;
+    }
+    return convertReturnVal(env, result, JNI_TRUE);
+}
+
+
+JNIEXPORT jlong JNICALL
+Java_sun_nio_ch_DatagramDispatcher_readv0(JNIEnv *env, jclass clazz,
+                                          jobject fdo, jlong address, jint len) {
+    int fd = fdval(env, fdo);
+    struct iovec *vectors = jlong_to_ptr(address);
+    ssize_t result = horizon_socket_vector(fd, vectors, len, 0, 1);
+    if (result < 0 && errno == ECONNREFUSED) {
+        JNU_ThrowByName(env, JNU_JAVANETPKG "PortUnreachableException", NULL);
+        return IOS_THROWN;
+    }
+    return convertLongReturnVal(env, result, JNI_TRUE);
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_DatagramDispatcher_write0(JNIEnv *env, jclass clazz,
+                                          jobject fdo, jlong address, jint len)
+{
+    jint fd = fdval(env, fdo);
+    void *buf = (void *)jlong_to_ptr(address);
+    int result = send(fd, buf, len, 0);
+    if (result < 0 && errno == ECONNREFUSED) {
+        JNU_ThrowByName(env, JNU_JAVANETPKG "PortUnreachableException", 0);
+        return IOS_THROWN;
+    }
+    return convertReturnVal(env, result, JNI_FALSE);
+}
+
+JNIEXPORT jlong JNICALL
+Java_sun_nio_ch_DatagramDispatcher_writev0(JNIEnv *env, jclass clazz,
+                                           jobject fdo, jlong address, jint len) {
+    int fd = fdval(env, fdo);
+    struct iovec *vectors = jlong_to_ptr(address);
+    ssize_t result = horizon_socket_vector(fd, vectors, len, 1, 1);
+    if (result < 0 && errno == ECONNREFUSED) {
+        JNU_ThrowByName(env, JNU_JAVANETPKG "PortUnreachableException", NULL);
+        return IOS_THROWN;
+    }
+    return convertLongReturnVal(env, result, JNI_FALSE);
+}
+
diff --git a/jdk/src/horizon/native/nio/FileChannelImpl.c b/jdk/src/horizon/native/nio/FileChannelImpl.c
new file mode 100644
index 00000000..67d60371
--- /dev/null
+++ b/jdk/src/horizon/native/nio/FileChannelImpl.c
@@ -0,0 +1,104 @@
+/*
+ * Copyright (c) 2026, MineSwitch contributors.
+ * DO NOT ALTER OR REMOVE COPYRIGHT NOTICES OR THIS FILE HEADER.
+ *
+ * This code is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 2 only, as
+ * published by the Free Software Foundation.  Oracle designates this
+ * particular file as subject to the "Classpath" exception as provided
+ * by Oracle in the LICENSE file that accompanied this code.
+ */
+
+/* Horizon (JDK 8) FileChannelImpl natives. Horizon cannot map SD files into
+ * memory. Read-only and private (copy-on-write) mappings are emulated with a
+ * page-aligned private copy read with positioned IO; such a view never sees
+ * later writes by others, which matches what the Java API guarantees for
+ * these modes on all platforms only loosely, and is documented as a Horizon
+ * limitation. Shared read/write mappings are rejected. */
+#include <errno.h>
+#include <malloc.h>
+#include <stdint.h>
+#include <string.h>
+#include "jni.h"
+#include "jni_util.h"
+#include "jlong.h"
+#include "nio.h"
+#include "nio_util.h"
+#include "horizon_file_io.h"
+#include "sun_nio_ch_FileChannelImpl.h"
+
+#define HORIZON_PAGE 4096
+
+static jfieldID chan_fd;        /* jobject 'fd' in sun.nio.ch.FileChannelImpl */
+
+JNIEXPORT jlong JNICALL
+Java_sun_nio_ch_FileChannelImpl_initIDs(JNIEnv *env, jclass clazz)
+{
+    chan_fd = (*env)->GetFieldID(env, clazz, "fd", "Ljava/io/FileDescriptor;");
+    return HORIZON_PAGE;
+}
+
+JNIEXPORT jlong JNICALL
+Java_sun_nio_ch_FileChannelImpl_map0(JNIEnv *env, jobject this,
+                                     jint prot, jlong off, jlong len)
+{
+    if (prot == sun_nio_ch_FileChannelImpl_MAP_RW) {
+        JNU_ThrowByName(env, "java/lang/UnsupportedOperationException",
+                        "Horizon cannot map SD files for shared writing");
+        return IOS_THROWN;
+    }
+    if (off < 0 || len <= 0 || (uint64_t)len > SIZE_MAX - HORIZON_PAGE) {
+        JNU_ThrowIOException(env, "Invalid mapping range");
+        return IOS_THROWN;
+    }
+    jobject fdo = (*env)->GetObjectField(env, this, chan_fd);
+    int fd = fdval(env, fdo);
+    size_t size = (size_t)len;
+    unsigned char *copy = memalign(HORIZON_PAGE, (size + HORIZON_PAGE - 1) & ~(size_t)(HORIZON_PAGE - 1));
+    if (copy == NULL) {
+        JNU_ThrowByName(env, "java/lang/OutOfMemoryError", "Map failed");
+        return IOS_THROWN;
+    }
+    size_t done = 0;
+    while (done < size) {
+        size_t chunk = size - done;
+        if (chunk > (1u << 24)) chunk = 1u << 24;
+        ssize_t n = nxio_pread(fd, copy + done, chunk, (off_t)(off + (jlong)done));
+        if (n < 0 && errno == EINTR) continue;
+        if (n < 0) {
+            free(copy);
+            JNU_ThrowIOExceptionWithLastError(env, "Map failed");
+            return IOS_THROWN;
+        }
+        if (n == 0) break;          /* past end of file: zero-filled, as mmap */
+        done += (size_t)n;
+    }
+    memset(copy + done, 0, size - done);
+    return ptr_to_jlong(copy);
+}
+
+JNIEXPORT jint JNICALL
+Java_sun_nio_ch_FileChannelImpl_unmap0(JNIEnv *env, jobject this,
+                                       jlong address, jlong len)
+{
+    free(jlong_to_ptr(address));
+    return 0;
+}
+
+JNIEXPORT void JNICALL
+Java_sun_nio_ch_FileChannelImpl_close0(JNIEnv *env, jobject this, jobject fdo)
+{
+    jint fd = fdval(env, fdo);
+    if (fd != -1 && nxio_close(fd) < 0) {
+        JNU_ThrowIOExceptionWithLastError(env, "Close failed");
+    }
+}
+
+JNIEXPORT jlong JNICALL
+Java_sun_nio_ch_FileChannelImpl_transferTo0(JNIEnv *env, jobject this,
+                                            jobject srcFDO,
+                                            jlong position, jlong count,
+                                            jobject dstFDO)
+{
+    return IOS_UNSUPPORTED;        /* Java falls back to buffered copying. */
+}
