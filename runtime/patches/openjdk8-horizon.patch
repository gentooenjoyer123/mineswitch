+ */
+
+package sun.nio.ch;
+
+import java.io.FileDescriptor;
+import java.io.IOException;
+
+/**
+ * Horizon SD files have no inode identifier. This key is the stored canonical
+ * pathname captured for a writable descriptor. The filesystem prevents renaming
+ * or deleting the file while that write handle remains open. It is used for
+ * Java lock-overlap checks; actual exclusion comes from the native FS handle.
+ */
+public class FileKey {
+    private String canonicalPath;
+
+    private FileKey() { }
+
+    public static FileKey create(FileDescriptor fd) throws IOException {
+        FileKey key = new FileKey();
+        key.init(fd);
+        return key;
+    }
+
+    public int hashCode() {
+        return canonicalPath.hashCode();
+    }
+
+    public boolean equals(Object obj) {
+        if (obj == this)
+            return true;
+        if (!(obj instanceof FileKey))
+            return false;
+        return canonicalPath.equals(((FileKey)obj).canonicalPath);
+    }
+
+    private native void init(FileDescriptor fd) throws IOException;
+    private static native void initIDs();
+
+    static {
+        initIDs();
+    }
+}
