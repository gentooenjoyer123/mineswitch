+  const HorizonAArch64Context* context = (const HorizonAArch64Context*)raw;
+  st->print_cr("Register to memory mapping:");
+  st->cr();
+  for (int r = 0; r < 31; r++) {
+    st->print("X%-2d=", r);
+    print_location(st, (intptr_t)context->x[r]);
+  }
+  st->cr();
+}
