+void os::pause() {
+  char filename[MAX_PATH];
+  if (PauseAtStartupFile && PauseAtStartupFile[0]) {
+    jio_snprintf(filename, MAX_PATH, "%s", PauseAtStartupFile);
+  } else {
+    jio_snprintf(filename, MAX_PATH, "%s/vm.paused.%d", get_temp_directory(), current_process_id());
+  }
+  int fd = nxio_open(filename, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (fd < 0) {
+    jio_fprintf(stderr, "Could not open pause file '%s', continuing immediately.\n", filename);
+    return;
+  }
+  nxio_close(fd);
+  struct stat buf;
+  while (nxio_stat_path(filename, &buf) == 0) {
+    naked_short_sleep(100);
+  }
