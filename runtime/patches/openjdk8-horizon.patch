+
+jint os::init_2(void) {
+  // Signals, cross-process perf memory and NUMA do not exist in this port.
+  // Reject explicit requests; defaults are adjusted to actual capabilities.
+  if ((!FLAG_IS_DEFAULT(ReduceSignalUsage) && !ReduceSignalUsage) ||
+      (!FLAG_IS_DEFAULT(UsePerfData) && UsePerfData) || UseNUMA || UseNUMAInterleaving) {
+    jio_fprintf(defaultStream::error_stream(),
+                "Horizon requires -Xrs, -XX:-UsePerfData and no NUMA options\n");
+    return JNI_ERR;
+  }
+  FLAG_SET_ERGO(bool, ReduceSignalUsage, true);
+  FLAG_SET_ERGO(bool, UsePerfData, false);
+  FLAG_SET_ERGO(bool, UseNUMA, false);
+  FLAG_SET_ERGO(bool, UseNUMAInterleaving, false);
+
+  // Safepoint polling page: an ordinary nxvm reservation whose permission is
+  // toggled with real kernel page protection.
+  address polling_page = (address)nxvm_reserve(os::vm_page_size(), os::vm_page_size(), false);
+  guarantee(polling_page != NULL, "os::init_2: failed to allocate polling page");
+  guarantee(nxvm_commit(polling_page, os::vm_page_size(), false), "os::init_2: commit polling page");
+  guarantee(nxvm_protect(polling_page, os::vm_page_size(), NXVM_READ), "os::init_2: protect polling page");
+  os::set_polling_page(polling_page);
+
+  if (!UseMembar) {
+    address mem_serialize_page = (address)nxvm_reserve(os::vm_page_size(), os::vm_page_size(), false);
+    guarantee(mem_serialize_page != NULL && nxvm_commit(mem_serialize_page, os::vm_page_size(), false),
+              "Allocation of memory serialize page failed");
+    os::set_memory_serialize_page(mem_serialize_page);
+  }
+
+  os::Horizon::min_stack_allowed = MAX2(os::Horizon::min_stack_allowed,
+            (size_t)(StackYellowPages + StackRedPages + StackShadowPages) * os::vm_page_size() +
+                    (2 * BytesPerWord COMPILER2_PRESENT(+1)) * os::vm_page_size());
+
+  size_t threadStackSizeInBytes = ThreadStackSize * K;
+  if (threadStackSizeInBytes != 0 && threadStackSizeInBytes < os::Horizon::min_stack_allowed) {
+    tty->print_cr("\nThe stack size specified is too small, Specify at least " SIZE_FORMAT "k",
+                  os::Horizon::min_stack_allowed / K);
+    return JNI_ERR;
+  }
+  JavaThread::set_stack_size_at_create(round_to(threadStackSizeInBytes, vm_page_size()));
+
+  if (!reaper_started) {
+    pthread_attr_t attr;
+    int r = pthread_attr_init(&attr);
+    if (r == 0) r = pthread_attr_setstacksize(&attr, 128 * K);
+    if (r == 0) r = pthread_create(&reaper_thread, &attr, reap_threads, NULL);
+    pthread_attr_destroy(&attr);
+    if (r != 0) {
+      jio_fprintf(defaultStream::error_stream(), "Horizon reaper: %d\n", r);
+      return JNI_ERR;
+    }
+    reaper_started = true;
+  }
+  return JNI_OK;
+}
+
+void os::make_polling_page_unreadable(void) {
+  if (!nxvm_protect((char*)_polling_page, os::vm_page_size(), NXVM_NONE)) {
+    fatal("Could not disable polling page");
+  }
+}
+
+void os::make_polling_page_readable(void) {
+  if (!nxvm_protect((char*)_polling_page, os::vm_page_size(), NXVM_READ)) {
+    fatal("Could not enable polling page");
+  }
+}
+
+void os::shutdown() {
+  // allow PerfMemory to attempt cleanup of any persistent resources
+  perfMemory_exit();
+  // needs to remove object in file system
+  AttachListener::abort();
+  // flush buffered output, finish log files
+  ostream_abort();
+  // Check for abort hook
+  abort_hook_t abort_hook = Arguments::abort_hook();
+  if (abort_hook != NULL) {
+    abort_hook();
+  }
+}
+
+void os::abort(bool dump_core) {
+  os::shutdown();
+  horizon_exit_process(1, 0);
+}
+
+void os::die() {
+  horizon_exit_process(1, 0);
+}
+
+void os::breakpoint() {
+  BREAKPOINT;
+}
