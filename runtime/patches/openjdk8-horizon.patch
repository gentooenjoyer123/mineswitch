+bool ElfDecoder::demangle(const char* symbol, char *buf, int buflen) {
+  int status;
+  char* result;
+  size_t size = (size_t)buflen;
+  if ((result = abi::__cxa_demangle(symbol, buf, &size, &status)) != NULL) {
+    jio_snprintf(buf, buflen, "%s", result);
+    // call c library's free
+    ::free(result);
+    return true;
+  }
+  return false;
+}
