+int os::available(int fd, jlong *bytes) {
+  struct stat buf;
+  if (nxio_fstat(fd, &buf) >= 0 && S_ISREG(buf.st_mode)) {
+    jlong cur = nxio_seek(fd, 0L, SEEK_CUR);
+    if (cur == -1) return 0;
+    jlong end = buf.st_size;
+    *bytes = end > cur ? end - cur : 0;
+    return 1;
+  }
+  return 0; // character devices and sockets report unavailable here
+}
