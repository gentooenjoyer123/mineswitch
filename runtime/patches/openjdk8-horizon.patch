+////////////////////////////////////////////////////////////////////////////////
+// files
+
+int os::open(const char *path, int oflag, int mode) {
+  if (strlen(path) > MAX_PATH - 1) {
+    errno = ENAMETOOLONG;
+    return -1;
+  }
+  int fd;
+  do {
+    fd = nxio_open(path, oflag, mode);
+  } while (fd < 0 && errno == EINTR);
+  if (fd < 0) return -1;
+  // If the open succeeded, the file might still be a directory.
+  struct stat buf;
+  if (nxio_fstat(fd, &buf) != 0) {
+    int e = errno;
+    nxio_close(fd);
+    errno = e;
+    return -1;
+  }
+  if ((buf.st_mode & S_IFMT) == S_IFDIR) {
+    nxio_close(fd);
+    errno = EISDIR;
+    return -1;
+  }
+  return fd;
+}
