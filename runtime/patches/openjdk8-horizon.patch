+JNIEXPORT jbyteArray JNICALL Java_sun_nio_fs_UnixNativeDispatcher_getcwd(JNIEnv *env, jclass ignored) {
+    char buffer[PATH_MAX + 1];
+    if (getcwd(buffer, sizeof(buffer)) == NULL) { throwUnixException(env, errno); return NULL; }
+    return default_path(env, buffer);
+}
+JNIEXPORT jbyteArray JNICALL Java_sun_nio_fs_UnixNativeDispatcher_strerror(JNIEnv *env, jclass ignored, jint error) {
+    return to_bytes(env, strerror(error));
+}
+JNIEXPORT jbyteArray JNICALL Java_sun_nio_fs_UnixNativeDispatcher_realpath0(JNIEnv *env, jclass ignored, jlong path) {
+    char *resolved = nxio_canonical_sd_path((const char*)jlong_to_ptr(path));
+    if (resolved == NULL) { throwUnixException(env, errno); return NULL; }
+    jbyteArray result = default_path(env, resolved);
+    free(resolved);
+    return result;
+}
