+        .align  5
+        ldp     t0, t1, [s, #16]        // -1 = 7 words
+        ldp     t2, t3, [s, #32]
+        ldp     t4, t5, [s, #48]
+        ldr     t6, [s, #64]
+        str     t0, [d, #8]
+        stp     t1, t2, [d, #16]
+        stp     t3, t4, [d, #32]
+        stp     t5, t6, [d, #48]
