diff --git a/jdk/src/horizon/native/net/horizon_net_close.c b/jdk/src/horizon/native/net/horizon_net_close.c
new file mode 100644
index 00000000..35e1cae3
--- /dev/null
+++ b/jdk/src/horizon/native/net/horizon_net_close.c
@@ -0,0 +1,143 @@
+/*
+ * Copyright (c) 2026, MineSwitch contributors.
+ * DO NOT ALTER OR REMOVE COPYRIGHT NOTICES OR THIS FILE HEADER.
+ *
+ * This code is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 2 only, as
+ * published by the Free Software Foundation.  Oracle designates this
+ * particular file as subject to the "Classpath" exception as provided
+ * by Oracle in the LICENSE file that accompanied this code.
+ */
+
+/* Horizon replacement for JDK 8 linux_close.c. Linux tracks the threads
+ * blocked on each descriptor and wakes them with a signal when the descriptor
+ * is closed or dup2'ed over. Horizon has no POSIX signals, so the wrappers
+ * call the libnx BSD socket functions directly (restarting on EINTR), and
+ * NET_SocketClose shuts the connection down first, which releases a thread
+ * blocked in a receive on it (Java 21 Horizon device test). PlainSocketImpl
+ * has no marker descriptor on Horizon, so NET_Dup2 is never used for a
+ * deferred close. */
+
+#include <errno.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+#include "net_util.h"
+
+#define RESTART(expr) do { \
+    int _result; \
+    do { _result = (expr); } while (_result == -1 && errno == EINTR); \
+    return _result; \
+} while (0)
+
+int NET_Dup2(int fd, int fd2) {
+    errno = (fd < 0) ? EBADF : ENOTSUP;
+    return -1;
+}
+
+int NET_SocketClose(int fd) {
+    int result;
+    (void)shutdown(fd, SHUT_RDWR);  /* Not connected: ENOTCONN, ignored. */
+    do {
+        result = close(fd);
+    } while (result == -1 && errno == EINTR);
+    return result;
+}
+
+int NET_Read(int s, void* buf, size_t len) {
+    RESTART(recv(s, buf, len, 0));
+}
+
+int NET_NonBlockingRead(int s, void* buf, size_t len) {
+    RESTART(recv(s, buf, len, MSG_DONTWAIT));
+}
+
+/* One receive into the first non-empty vector element: a stream socket may
+ * return a short count, and a datagram must not be split over calls. */
+int NET_ReadV(int s, const struct iovec * vector, int count) {
+    int i;
+    for (i = 0; i < count; i++) {
+        if (vector[i].iov_len > 0) {
+            RESTART(recv(s, vector[i].iov_base, vector[i].iov_len, 0));
+        }
+    }
+    return 0;
+}
+
+int NET_RecvFrom(int s, void *buf, int len, unsigned int flags,
+       struct sockaddr *from, int *fromlen) {
+    socklen_t socklen = *fromlen;
+    int result;
+    do {
+        result = recvfrom(s, buf, len, flags, from, &socklen);
+    } while (result == -1 && errno == EINTR);
+    *fromlen = socklen;
+    return result;
+}
+
+int NET_Send(int s, void *msg, int len, unsigned int flags) {
+    RESTART(send(s, msg, len, flags));
+}
+
+int NET_WriteV(int s, const struct iovec * vector, int count) {
+    int i;
+    for (i = 0; i < count; i++) {
+        if (vector[i].iov_len > 0) {
+            RESTART(send(s, vector[i].iov_base, vector[i].iov_len, 0));
+        }
+    }
+    return 0;
+}
+
+int NET_SendTo(int s, const void *msg, int len,  unsigned  int
+       flags, const struct sockaddr *to, int tolen) {
+    RESTART(sendto(s, msg, len, flags, to, tolen));
+}
+
+int NET_Accept(int s, struct sockaddr *addr, int *addrlen) {
+    socklen_t socklen = *addrlen;
+    int result;
+    do {
+        result = accept(s, addr, &socklen);
+    } while (result == -1 && errno == EINTR);
+    *addrlen = socklen;
+    return result;
+}
+
+int NET_Connect(int s, struct sockaddr *addr, int addrlen) {
+    RESTART(connect(s, addr, addrlen));
+}
+
+int NET_Poll(struct pollfd *ufds, unsigned int nfds, int timeout) {
+    return poll(ufds, nfds, timeout);
+}
+
+/* poll(s) with a timeout in milliseconds, adjusted on EINTR. */
+int NET_Timeout0(int s, long timeout, long currentTime) {
+    long prevtime = currentTime, newtime;
+    struct timeval t;
+    for (;;) {
+        struct pollfd pfd;
+        int rv;
+        pfd.fd = s;
+        pfd.events = POLLIN | POLLERR;
+        pfd.revents = 0;
+        rv = poll(&pfd, 1, timeout);
+        if (rv < 0 && errno == EINTR) {
+            if (timeout > 0) {
+                gettimeofday(&t, NULL);
+                newtime = t.tv_sec * 1000 + t.tv_usec / 1000;
+                timeout -= newtime - prevtime;
+                if (timeout <= 0) {
+                    return 0;
+                }
+                prevtime = newtime;
+            }
+        } else {
+            return rv;
+        }
+    }
+}
