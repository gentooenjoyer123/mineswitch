+
+package sun.nio.fs;
+
+import java.io.IOException;
+import java.nio.file.FileStore;
+import java.nio.file.WatchService;
+import java.util.Collections;
+import java.util.List;
+import java.util.Set;
+
+/** Java's slash-root is the launcher's default sdmc: device. */
+class HorizonFileSystem extends UnixFileSystem {
+    HorizonFileSystem(UnixFileSystemProvider provider, String dir) {
+        super(provider, dir);
+    }
+
+    @Override
+    public WatchService newWatchService() throws IOException {
+        // No inotify: the portable polling implementation.
+        return new PollingWatchService();
+    }
+
+    @Override
+    public Set<String> supportedFileAttributeViews() {
+        return Collections.singleton("basic");
+    }
+
+    @Override
+    void copyNonPosixAttributes(int ofd, int nfd) {
+        // This filesystem exposes no additional extended attribute view.
+    }
+
+    @Override
+    List<UnixMountEntry> getMountEntries() {
+        // There is no mount table; Files.getFileStore(path) still works via
+        // HorizonFileSystemProvider.getFileStore(UnixPath).
+        return Collections.emptyList();
+    }
+
+    @Override
+    FileStore getFileStore(UnixMountEntry entry) throws IOException {
+        return new HorizonFileStore(new UnixPath(this, entry.dir()));
+    }
+}
