+        ldr     t4, [s, #48]
+        str     t0, [d, #8]
+        stp     t1, t2, [d, #16]
+        stp     t3, t4, [d, #32]
+        ret
+        .align  5
+        ldp     t0, t1, [s, #16]        // -2 = 6 words
