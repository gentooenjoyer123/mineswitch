+void os::print_context(outputStream *st, void *raw) {
+  if (raw == NULL) return;
+  const HorizonAArch64Context* context = (const HorizonAArch64Context*)raw;
+  st->print_cr("Horizon own-thread exception registers:");
+  for (int i = 0; i < 31; ++i) {
+    st->print_cr("X%d=" INTPTR_FORMAT, i, (intptr_t)context->x[i]);
+  }
+  st->print_cr("SP=" INTPTR_FORMAT " PC=" INTPTR_FORMAT " FAR=" INTPTR_FORMAT,
+               (intptr_t)context->sp, (intptr_t)context->pc, (intptr_t)context->far);
+  st->print_cr("PSTATE=%08x ESR=%08x description=%08x",
+               context->pstate, context->esr, context->description);
+  st->cr();
+  intptr_t *sp = (intptr_t *)context->sp;
+  st->print_cr("Top of Stack: (sp=" PTR_FORMAT ")", p2i(sp));
+  print_hex_dump(st, (address)sp, (address)(sp + 8*sizeof(intptr_t)), sizeof(intptr_t));
+  st->cr();
+  address pc = (address)context->pc;
+  st->print_cr("Instructions: (pc=" PTR_FORMAT ")", p2i(pc));
+  print_hex_dump(st, pc - 32, pc + 32, sizeof(char));
+}
