+
+// HotSpot 8 memory contracts on the shared MineSwitch backends:
+// nxvm (eagerly backed reservations with real kernel page permissions) and
+// nxjit (CodeMemory with simultaneous RW/RX aliases). Semantics match the
+// Java 17/21 Horizon ports (runtime/memory/README.md, docs/HORIZON_JIT_MEMORY.md).
+
+#include "precompiled.hpp"
+#include "runtime/globals.hpp"
+#include "runtime/java.hpp"
+#include "runtime/os.hpp"
+#include "services/memTracker.hpp"
+#include "utilities/debug.hpp"
+#include "utilities/ostream.hpp"
+#include "nx_memory.h"
+#include "nx_jit.h"
+
+#include <errno.h>
+
+char* os::pd_reserve_memory(size_t bytes, char* requested_addr, size_t alignment_hint) {
+  if (requested_addr != NULL) {
+    // newlib owns the heap address space; fixed placement is unsupported.
+    errno = ENOTSUP;
+    return NULL;
+  }
+  size_t alignment = MAX2((size_t)os::vm_allocation_granularity(), alignment_hint);
+  return (char*)nxvm_reserve(bytes, alignment, false);
+}
+
+char* os::reserve_memory_aligned(size_t size, size_t alignment) {
+  assert((alignment & (os::vm_allocation_granularity() - 1)) == 0,
+      "Alignment must be a multiple of allocation granularity (page size)");
+  assert((size & (alignment -1)) == 0, "size must be 'alignment' aligned");
+  // Direct aligned allocation avoids temporarily backing alignment-sized slack.
+  char* result = (char*)nxvm_reserve(size, alignment, false);
+  if (result != NULL) {
+    MemTracker::record_virtual_memory_reserve((address)result, size, CALLER_PC);
+  }
+  return result;
+}
+
+char* os::pd_attempt_reserve_memory_at(size_t bytes, char* requested_addr) {
+  // newlib owns the heap address space; never overwrite another allocation.
+  errno = ENOTSUP;
+  return NULL;
+}
+
+bool os::pd_commit_memory(char* addr, size_t size, bool exec) {
+  return nxvm_commit(addr, size, exec);
+}
+
+bool os::pd_commit_memory(char* addr, size_t size, size_t alignment_hint, bool exec) {
+  return pd_commit_memory(addr, size, exec);
+}
+
+void os::pd_commit_memory_or_exit(char* addr, size_t size, bool exec, const char* mesg) {
+  if (!pd_commit_memory(addr, size, exec)) {
+    vm_exit_out_of_memory(size, OOM_MMAP_ERROR, err_msg("%s (Horizon rc=0x%08x, errno=%d)",
+                          mesg, nxvm_last_result(), errno));
+  }
+}
+
+void os::pd_commit_memory_or_exit(char* addr, size_t size, size_t alignment_hint,
+                                  bool exec, const char* mesg) {
+  pd_commit_memory_or_exit(addr, size, exec, mesg);
+}
+
+bool os::pd_uncommit_memory(char* addr, size_t size) {
+  // Revokes access and arranges zero-on-recommit; physical backing is retained.
+  return nxvm_uncommit(addr, size);
+}
+
+bool os::pd_release_memory(char* addr, size_t size) {
+  return nxvm_release(addr, size);
+}
+
+bool os::protect_memory(char* addr, size_t bytes, ProtType prot, bool is_committed) {
+  switch (prot) {
+    case MEM_PROT_NONE: return nxvm_protect(addr, bytes, NXVM_NONE);
+    case MEM_PROT_READ: return nxvm_protect(addr, bytes, NXVM_READ);
+    case MEM_PROT_RW:   return nxvm_protect(addr, bytes, NXVM_READ_WRITE);
+    case MEM_PROT_RWX:  errno = ENOTSUP; return false;
+    default:            ShouldNotReachHere(); return false;
+  }
+}
+
+// Stack guard zones live inside the owned libnx thread stack mapping and use
+// the SDK worker's mirror/backing unmap/remap pair (docs/HORIZON_STACK_GUARDS.md).
+bool os::guard_memory(char* addr, size_t bytes) {
+  return nxvm_protect_current_stack(addr, bytes, NXVM_NONE);
+}
+
+bool os::unguard_memory(char* addr, size_t bytes) {
+  return nxvm_protect_current_stack(addr, bytes, NXVM_READ_WRITE);
+}
+
+bool os::pd_create_stack_guard_pages(char* addr, size_t size) {
+  return nxvm_protect_current_stack(addr, size, NXVM_READ_WRITE);
+}
+
+bool os::remove_stack_guard_pages(char* addr, size_t size) {
+  return nxvm_protect_current_stack(addr, size, NXVM_READ_WRITE);
+}
+
+void os::pd_free_memory(char *addr, size_t bytes, size_t alignment_hint) {
+  // Discard data without claiming to return physical memory to the kernel.
+  if (!nxvm_discard(addr, bytes)) {
+    warning("Cannot discard Horizon memory: " PTR_FORMAT ", " SIZE_FORMAT
+            " bytes (rc=0x%08x, errno=%d)", p2i(addr), bytes, nxvm_last_result(), errno);
+  }
+}
+
+void os::pd_realign_memory(char *addr, size_t bytes, size_t alignment_hint) {
+  // A placement hint only. Horizon's backend exposes 4 KiB pages.
+}
+
+void os::large_page_init() {
+  if (UseLargePages) {
+    warning("Large pages are not supported by the Horizon heap backend");
+    UseLargePages = false;
+  }
+}
+
+size_t os::large_page_size() { return 0; }
+bool os::can_commit_large_page_memory() { return false; }
+bool os::can_execute_large_page_memory() { return false; }
+
+// Native code space: CodeMemory pins and maps its complete allocation with
+// distinct RW and RX aliases (returned base is the RW alias). Reserved and
+// committed are recorded together; there is no sparse executable commit.
+char* os::reserve_memory_special(size_t bytes, size_t alignment, char* req_addr, bool exec) {
+  if (exec && req_addr == NULL) {
+    NxJitArena* arena = nxjit_create(bytes, MAX2(alignment, (size_t)os::vm_page_size()));
+    if (arena == NULL) return NULL;
+    char* addr = (char*)nxjit_rw_address(arena);
+    MemTracker::record_virtual_memory_reserve_and_commit((address)addr, bytes, CALLER_PC);
+    return addr;
+  }
+  errno = ENOTSUP;
+  return NULL;
+}
+
+bool os::release_memory_special(char* base, size_t bytes) {
+  if (!nxjit_contains(base, bytes)) {
+    errno = ENOTSUP;
+    return false;
+  }
+  if (MemTracker::tracking_level() > NMT_minimal) {
+    Tracker tkr = MemTracker::get_virtual_memory_release_tracker();
+    bool res = nxjit_release_memory(base, bytes);
+    if (res) {
+      tkr.record((address)base, bytes);
+    }
+    return res;
+  }
+  return nxjit_release_memory(base, bytes);
+}
+
+// Read immutable named VM data files through a private descriptor eagerly;
+// shared file-backed mappings and fixed/replacement mappings are unsupported.
+char* os::pd_map_memory(int fd, const char* file_name, size_t file_offset,
+                        char *addr, size_t bytes, bool read_only, bool allow_exec) {
+  if (file_name == NULL || addr != NULL || allow_exec) {
+    errno = ENOTSUP;
+    return NULL;
+  }
+  return (char*)nxvm_map_file_private(file_name, file_offset, bytes, read_only);
+}
+
+char* os::pd_remap_memory(int fd, const char* file_name, size_t file_offset,
+                          char *addr, size_t bytes, bool read_only, bool allow_exec) {
+  errno = ENOTSUP;
+  return NULL;
+}
+
+bool os::pd_unmap_memory(char* addr, size_t bytes) {
+  return nxvm_unmap_file(addr, bytes);
+}
+
+void os::numa_make_global(char *addr, size_t bytes) {}
+void os::numa_make_local(char *addr, size_t bytes, int lgrp_hint) {}
+bool os::numa_topology_changed() { return false; }
+size_t os::numa_get_groups_num() { return 1; }
+int os::numa_get_group_id() { return 0; }
+size_t os::numa_get_leaf_groups(int *ids, size_t size) {
+  if (size > 0) {
+    ids[0] = 0;
+    return 1;
+  }
+  return 0;
+}
+
+bool os::get_page_info(char *start, page_info* info) { return false; }
+
+char *os::scan_pages(char *start, char* end, page_info* page_expected, page_info* page_found) {
+  return end;
+}
