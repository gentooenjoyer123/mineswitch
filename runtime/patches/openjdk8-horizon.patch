+package sun.security.provider;
+
+import java.io.IOException;
+import java.security.ProviderException;
+
+/**
+ * Seeds Java's random generators from Horizon's CSRNG (csrng/randomGet)
+ * instead of the absent /dev/random.
+ */
+class NativeSeedGenerator extends SeedGenerator {
+
+    NativeSeedGenerator(String ignoredSeedFile) throws IOException {
+        super();
+        if (!nativeGenerateSeed(new byte[32])) {
+            throw new IOException("Horizon CSRNG service is unavailable");
+        }
+    }
+
+    private static native boolean nativeGenerateSeed(byte[] result);
+
+    @Override
+    void getSeedBytes(byte[] result) {
+        if (!nativeGenerateSeed(result)) {
+            throw new ProviderException("Horizon CSRNG failed to generate seed material");
+        }
+    }
+}
