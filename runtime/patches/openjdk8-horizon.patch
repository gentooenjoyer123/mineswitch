+size_t os::read(int fd, void *buf, unsigned int nBytes) {
+  return (size_t)nxio_read(fd, buf, nBytes);
+}
+
+size_t os::read_at(int fd, void *buf, unsigned int nBytes, jlong offset) {
+  ssize_t r;
+  do { r = nxio_pread(fd, buf, nBytes, (off_t)offset); } while (r < 0 && errno == EINTR);
+  return (size_t)r;
+}
