+#ifndef OS_HORIZON_VM_OS_HORIZON_HPP
+#define OS_HORIZON_VM_OS_HORIZON_HPP
+
+// Included inside the body of class os (JDK 8 layout), in place of
+// os_linux.hpp + os_posix.hpp. Only member declarations belong here.
+// Horizon/newlib has no POSIX signals, mmap or dlopen; see the Java 17/21
+// Horizon ports (docs/JAVA17_PORT.md) for the shared backend contracts.
+
+// Information about the protection of the page at address '0' on this os.
+static bool zero_page_read_protected() { return true; }
+
+class Horizon {
+  friend class os;
+ public:
+  static size_t min_stack_allowed;          // defined in os_horizon_aarch64.cpp
+  static pthread_condattr_t _condattr[1];   // relative waits use CLOCK_MONOTONIC when available
+  static bool _monotonic_condattr;
+  static pthread_condattr_t* condAttr()     { return _condattr; }
+  static bool supports_monotonic_clock()    { return _monotonic_condattr; }
+  static void init_sync();
+  static size_t default_stack_size(os::ThreadType thr_type);
+};
+
+class PlatformEvent : public CHeapObj<mtInternal> {
+  private:
+    double CachePad [4] ;   // increase odds that _mutex is sole occupant of cache line
+    volatile int _Event ;
+    volatile int _nParked ;
+    pthread_mutex_t _mutex  [1] ;
+    pthread_cond_t  _cond   [1] ;
+    double PostPad  [2] ;
+    Thread * _Assoc ;
+
+  public:       // TODO-FIXME: make dtor private
+    ~PlatformEvent() { guarantee (0, "invariant") ; }
+
+  public:
+    PlatformEvent() {
+      int status;
+      status = pthread_cond_init (_cond, os::Horizon::condAttr());
+      assert_status(status == 0, status, "cond_init");
+      status = pthread_mutex_init (_mutex, NULL);
+      assert_status(status == 0, status, "mutex_init");
+      _Event   = 0 ;
+      _nParked = 0 ;
+      _Assoc   = NULL ;
+    }
+
+    // Use caution with reset() and fired() -- they may require MEMBARs
+    void reset() { _Event = 0 ; }
+    int  fired() { return _Event; }
+    void park () ;
+    void unpark () ;
+    int  TryPark () ;
+    int  park (jlong millis) ; // relative timed-wait only
+    void SetAssociation (Thread * a) { _Assoc = a ; }
+} ;
+
+class PlatformParker : public CHeapObj<mtInternal> {
+  protected:
+    enum {
+        REL_INDEX = 0,
+        ABS_INDEX = 1
+    };
+    int _cur_index;  // which cond is in use: -1, 0, 1
+    pthread_mutex_t _mutex [1] ;
+    pthread_cond_t  _cond  [2] ; // one for relative times and one for abs.
+
+  public:       // TODO-FIXME: make dtor private
+    ~PlatformParker() { guarantee (0, "invariant") ; }
+
+  public:
+    PlatformParker() {
+      int status;
+      status = pthread_cond_init (&_cond[REL_INDEX], os::Horizon::condAttr());
+      assert_status(status == 0, status, "cond_init rel");
+      status = pthread_cond_init (&_cond[ABS_INDEX], NULL);
+      assert_status(status == 0, status, "cond_init abs");
+      status = pthread_mutex_init (_mutex, NULL);
+      assert_status(status == 0, status, "mutex_init");
+      _cur_index = -1; // mark as unused
+    }
+};
+
+#endif // OS_HORIZON_VM_OS_HORIZON_HPP
