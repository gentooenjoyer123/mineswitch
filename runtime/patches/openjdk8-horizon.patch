+ * under the terms of the GNU General Public License version 2 only, as
+ * published by the Free Software Foundation.
+ */
+
+#include "precompiled.hpp"
+#include "runtime/threadCritical.hpp"
+#include <pthread.h>
+
+// ThreadCritical is reentrant, including before HotSpot TLS initialization.
+// A per-native-thread depth avoids an unsynchronized shared owner read
+// (same implementation as the Java 17/21 Horizon ports).
+
+static pthread_mutex_t critical_mutex = PTHREAD_MUTEX_INITIALIZER;
+static __thread unsigned critical_depth = 0;
+
+void ThreadCritical::initialize() {}
+void ThreadCritical::release() {}
+
+ThreadCritical::ThreadCritical() {
+  if (critical_depth == 0) guarantee(pthread_mutex_lock(&critical_mutex) == 0, "ThreadCritical lock");
+  ++critical_depth;
+}
+
+ThreadCritical::~ThreadCritical() {
+  guarantee(critical_depth != 0, "ThreadCritical imbalance");
+  if (--critical_depth == 0) guarantee(pthread_mutex_unlock(&critical_mutex) == 0, "ThreadCritical unlock");
+}
