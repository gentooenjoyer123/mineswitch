+static jfieldID attrs_st_ctime_sec;
+static jfieldID attrs_st_ctime_nsec;
+static jfieldID attrs_f_frsize;
+static jfieldID attrs_f_blocks;
+static jfieldID attrs_f_bfree;
+static jfieldID attrs_f_bavail;
