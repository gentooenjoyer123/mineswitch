+
+#define COPY_SMALL(from, to, count)                                     \
+{                                                                       \
+        long tmp0, tmp1, tmp2, tmp3;                                    \
+        long tmp4, tmp5, tmp6, tmp7;                                    \
+  __asm volatile(                                                       \
+"       adr     %[t0], 0f;"                                             \
+"       add     %[t0], %[t0], %[cnt], lsl #6;"                          \
+"       br      %[t0];"                                                 \
+"       .align  6;"                                                     \
+"0:"                                                                    \
+"       b       1f;"                                                    \
+"8:"                                                                    \
+"       ldr     %[t0], [%[s], #0];"                                     \
+"       ldp     %[t1], %[t2], [%[s], #8];"                              \
+"       ldp     %[t3], %[t4], [%[s], #24];"                             \
+"       ldr     %[t5], [%[s], #40];"                                    \
