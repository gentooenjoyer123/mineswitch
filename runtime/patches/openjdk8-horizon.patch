+#include <stdio.h>
+#include <time.h>
+#include <switch.h>
+#include "TimeZone_md.h"
+
+char* findJavaTZ_md(const char* java_home_dir) {
+    const char* override=getenv("TZ");
+    if (override && *override) return strdup(override[0]==':'?override+1:override);
+    if (R_FAILED(timeInitialize())) return NULL;
+    TimeLocationName name;
+    Result rc=timeGetDeviceLocationName(&name);
+    timeExit();
+    if (R_FAILED(rc)) return NULL;
+    char terminated[sizeof(name.name)+1];
+    memcpy(terminated,name.name,sizeof(name.name)); terminated[sizeof(name.name)]=0;
+    return terminated[0]?strdup(terminated):NULL;
+}
+char* getGMTOffsetID(void) {
+    if (R_FAILED(timeInitialize())) return NULL;
+    TimeCalendarTime calendar;
+    TimeCalendarAdditionalInfo info;
+    Result rc=timeToCalendarTimeWithMyRule((u64)time(NULL),&calendar,&info);
+    timeExit();
+    if (R_FAILED(rc)) return NULL;
+    int offset=info.offset;
+    if (!offset) return strdup("GMT");
+    char value[24]; int absolute=offset<0?-offset:offset;
+    snprintf(value,sizeof(value),"GMT%c%02d:%02d",offset<0?'-':'+',absolute/3600,(absolute/60)%60);
+    return strdup(value);
+}
