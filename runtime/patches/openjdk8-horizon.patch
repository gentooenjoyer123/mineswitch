+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <limits.h>
+#include <switch.h>
+#include "jni.h"
+#include "jni_util.h"
+#include "java_props.h"
+
+java_props_t* GetJavaProperties(JNIEnv* env) {
+    static java_props_t props;
+    static char working[PATH_MAX];
+    static char firmware[32];
+    static char language[9]="en", country[9]="US", script[9]="";
+    if (props.user_dir) return &props;
+    if (!getcwd(working,sizeof(working))) {
+        JNU_ThrowIOExceptionWithLastError(env,"Cannot obtain working directory");
+        return NULL;
+    }
+    if (!strncmp(working,"sdmc:",5)) memmove(working,working+5,strlen(working+5)+1);
+    if (working[0]!='/') {
+        JNU_ThrowIOException(env,"Horizon Java requires an absolute SD working directory");
+        return NULL;
+    }
+    u32 version=hosversionGet();
+    snprintf(firmware,sizeof(firmware),"%u.%u.%u",HOSVER_MAJOR(version),HOSVER_MINOR(version),HOSVER_MICRO(version));
+    props.os_name="Horizon";
+    props.os_version=firmware;
+    props.os_arch="aarch64";
+    props.tmp_dir="/switch/mineswitch/tmp";
+    props.user_name=getenv("USER"); if (!props.user_name) props.user_name="switch";
+    props.user_home="/switch/mineswitch";
+    if (R_SUCCEEDED(setInitialize())) {
+        u64 code=0;
+        if (R_SUCCEEDED(setGetSystemLanguage(&code))) {
+            char text[9]; memcpy(text,&code,8); text[8]=0;
+            char* dash=strchr(text,'-');
+            if (dash) *dash++=0;
+            snprintf(language,sizeof(language),"%s",text);
+            country[0]=script[0]=0;
+            if (dash) {
+                char* next=strchr(dash,'-');
+                if (next) *next++=0;
+                if (strlen(dash)==4) {
+                    snprintf(script,sizeof(script),"%s",dash);
+                    if (next) snprintf(country,sizeof(country),"%s",next);
+                } else snprintf(country,sizeof(country),"%s",dash);
+            }
+        }
+        setExit();
+    }
+    props.language=props.format_language=props.display_language=language;
+    props.country=props.format_country=props.display_country=country;
+    props.script=props.format_script=props.display_script=script;
+    props.variant=props.format_variant=props.display_variant="";
+    props.encoding=props.sun_jnu_encoding="UTF-8";
+    props.sun_stdout_encoding=props.sun_stderr_encoding="UTF-8";
+    props.unicode_encoding="UnicodeLittle";
+    props.cpu_endian="little";
+    props.cpu_isalist="aarch64";
+    props.data_model="64";
+    props.file_separator="/"; props.path_separator=";"; props.line_separator="\n";
+    props.user_dir=working;
+    props.font_dir=NULL;
+    props.patch_level="unknown";
+    props.desktop=NULL;
+    /* Java2D software GE provided by the Horizon class overlay (headless). */
+    props.graphics_env="sun.awt.HorizonGraphicsEnvironment";
+    props.awt_toolkit=NULL;
+    props.printerJob="sun.print.PSPrinterJob";
+    props.timezone=NULL;
+    return &props;
+}
+jstring GetStringPlatform(JNIEnv* env,nchar* text) { return JNU_NewStringPlatform(env,text); }
