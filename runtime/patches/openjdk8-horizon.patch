+////////////////////////////////////////////////////////////////////////////////
+// Registered static JNI libraries replace ELF dlopen/dlsym. No unregistered
+// library is reported loaded: callers receive an explicit unsupported error.
+
+struct StaticLibrary { const char* name; const HorizonNativeSymbol* symbols; size_t count; };
+static StaticLibrary libraries[64];
+static size_t library_count = 0;
+static char process_handle;
+static pthread_mutex_t library_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+extern "C" int horizon_register_native_library(const char* name, const HorizonNativeSymbol* symbols, size_t count) {
+  if (name == NULL || (symbols == NULL && count != 0)) return EINVAL;
+  pthread_mutex_lock(&library_mutex);
+  if (library_count == ARRAY_SIZE(libraries)) { pthread_mutex_unlock(&library_mutex); return ENOSPC; }
+  for (size_t i = 0; i < library_count; i++) {
+    if (strcmp(name, libraries[i].name) == 0) { pthread_mutex_unlock(&library_mutex); return EEXIST; }
+  }
+  libraries[library_count].name = name;
+  libraries[library_count].symbols = symbols;
+  libraries[library_count].count = count;
+  library_count++;
+  pthread_mutex_unlock(&library_mutex);
+  return 0;
+}
+
+extern "C" int horizon_has_native_library(const char* name) {
+  if (name == NULL) return 0;
+  int found = 0;
+  pthread_mutex_lock(&library_mutex);
+  for (size_t i = 0; i < library_count; i++) {
+    if (strcmp(name, libraries[i].name) == 0) { found = 1; break; }
+  }
+  pthread_mutex_unlock(&library_mutex);
+  return found;
+}
+
+extern "C" void* horizon_process_library_handle() { return &process_handle; }
+void* os::get_default_process_handle() { return &process_handle; }
+
+void* os::dll_lookup(void* handle, const char* name) {
+  void* result = NULL;
+  pthread_mutex_lock(&library_mutex);
+  for (size_t i = 0; i < library_count && result == NULL; i++) {
+    if (handle != &process_handle && handle != &libraries[i]) continue;
+    for (size_t j = 0; j < libraries[i].count; j++) {
+      if (strcmp(name, libraries[i].symbols[j].name) == 0) { result = libraries[i].symbols[j].address; break; }
+    }
+  }
+  pthread_mutex_unlock(&library_mutex);
+  return result;
+}
+
+void* os::dll_load(const char* name, char* ebuf, int ebuflen) {
+  const char* basename = strrchr(name, '/');
+  basename = basename != NULL ? basename + 1 : name;
+  char canonical[128];
+  jio_snprintf(canonical, sizeof(canonical), "%s", basename);
+  char* shortname = canonical;
+  if (strncmp(shortname, "lib", 3) == 0) shortname += 3;
+  char* dot = strrchr(shortname, '.');
+  if (dot != NULL && (strcmp(dot, ".so") == 0 || strcmp(dot, ".a") == 0)) *dot = 0;
+  void* result = NULL;
+  pthread_mutex_lock(&library_mutex);
+  for (size_t i = 0; i < library_count; i++) {
+    if (strcmp(shortname, libraries[i].name) == 0) { result = &libraries[i]; break; }
+  }
+  pthread_mutex_unlock(&library_mutex);
+  if (result == NULL && ebuflen > 0) {
+    jio_snprintf(ebuf, ebuflen, "Horizon: native library '%s' is not statically registered", name);
+  }
+  return result;
+}
