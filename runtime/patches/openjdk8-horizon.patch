+#include "services/memTracker.hpp"
+#include "services/runtimeService.hpp"
+#include "utilities/decoder.hpp"
+#include "utilities/defaultStream.hpp"
+#include "utilities/events.hpp"
+#include "utilities/growableArray.hpp"
+#include "utilities/vmError.hpp"
+#include "horizon_bridge.h"
+#include "horizon_file_io.h"
+#include "horizon_aarch64_context.h"
+#include "nx_memory.h"
+#include "nx_jit.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <locale.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+
+#define MAX_PATH    (2 * K)
+
+// for timer info max values which include all bits
+#define ALL_64_BITS CONST64(0xFFFFFFFFFFFFFFFF)
+
+static jlong initial_time_count = 0;
+static int   _initial_pid       = 0;
+
+pthread_condattr_t os::Horizon::_condattr[1];
+bool os::Horizon::_monotonic_condattr = false;
+
+void os::Horizon::init_sync() {
+  int status = pthread_condattr_init(_condattr);
+  if (status != 0) fatal(err_msg("pthread_condattr_init: %s", strerror(status)));
+  status = pthread_condattr_setclock(_condattr, CLOCK_MONOTONIC);
+  if (status == 0) {
+    _monotonic_condattr = true;
+  } else if (status != EINVAL && status != ENOSYS) {
+    fatal(err_msg("pthread_condattr_setclock: %s", strerror(status)));
+  }
+}
+
+size_t os::Horizon::default_stack_size(os::ThreadType thr_type) {
+  // Same defaults as Linux/AArch64; JavaThread sizes come from -Xss.
+  size_t s = (thr_type == os::compiler_thread ? 4 * M : 1 * M);
+  return s;
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Thread creation. newlib does not implement detached libnx threads. Every
+// JVM-created thread remains joinable; the reaper owns its pthread after
+// Thread::run() returns (the Thread object may already be deleted by then).
+
+struct ThreadTicket {
+  Thread* thread;
+  pthread_t native;
+  ThreadTicket* next;
+};
+static pthread_mutex_t reaper_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  reaper_cond  = PTHREAD_COND_INITIALIZER;
+static ThreadTicket*   finished_threads = NULL;
+static pthread_t       reaper_thread;
+static bool            reaper_started = false;
+
+static void* reap_threads(void*) {
+  for (;;) {
+    guarantee(pthread_mutex_lock(&reaper_mutex) == 0, "reaper lock");
+    while (finished_threads == NULL) {
+      guarantee(pthread_cond_wait(&reaper_cond, &reaper_mutex) == 0, "reaper wait");
+    }
+    ThreadTicket* ticket = finished_threads;
+    finished_threads = ticket->next;
+    guarantee(pthread_mutex_unlock(&reaper_mutex) == 0, "reaper unlock");
+    int r = pthread_join(ticket->native, NULL);
+    guarantee(r == 0, err_msg("pthread_join: %d", r));
+    os::free(ticket);
+  }
+  return NULL;
+}
+
+static void* java_start(void* argument) {
+  ThreadTicket* ticket = (ThreadTicket*)argument;
+  Thread* thread = ticket->thread;
+  ThreadLocalStorage::set_thread(thread);
+  OSThread* osthread = thread->osthread();
+  Monitor* sync = osthread->startThread_lock();
+  osthread->set_thread_id(horizon_thread_id());
+  osthread->set_native_handle(horizon_thread_handle());
+  if (horizon_aarch64_exception_thread_init() != 0 || !nxvm_stack_guard_prepare()) {
+    horizon_aarch64_exception_thread_exit();
+    MutexLockerEx ml(sync, Mutex::_no_safepoint_check_flag);
+    osthread->set_state(ZOMBIE);
+    sync->notify_all();
+    return NULL;
+  }
+  os::setup_fpu();
+  {
+    MutexLockerEx ml(sync, Mutex::_no_safepoint_check_flag);
+    osthread->set_state(INITIALIZED);
+    sync->notify_all();
+    while (osthread->get_state() == INITIALIZED) {
+      sync->wait(Mutex::_no_safepoint_check_flag);
+    }
+  }
+  thread->run();
+  // No access to thread/osthread after this point.
+  guarantee(nxvm_stack_guard_cleanup(), "Cannot restore native thread stack mapping before exit");
+  horizon_aarch64_exception_thread_exit();
+  guarantee(pthread_mutex_lock(&reaper_mutex) == 0, "reaper lock");
+  ticket->next = finished_threads;
+  finished_threads = ticket;
+  guarantee(pthread_cond_signal(&reaper_cond) == 0, "reaper signal");
+  guarantee(pthread_mutex_unlock(&reaper_mutex) == 0, "reaper unlock");
+  return NULL;
+}
+
+bool os::create_thread(Thread* thread, ThreadType thr_type, size_t stack_size) {
+  assert(thread->osthread() == NULL, "caller responsible");
+  OSThread* osthread = new OSThread(NULL, NULL);
+  if (osthread == NULL) return false;
+  ThreadTicket* ticket = (ThreadTicket*)os::malloc(sizeof(ThreadTicket), mtThread);
+  if (ticket == NULL) { delete osthread; return false; }
+  memset(ticket, 0, sizeof(*ticket));
+  osthread->set_thread_type(thr_type);
+  osthread->set_state(ALLOCATED);
+  thread->set_osthread(osthread);
+  ticket->thread = thread;
+
+  if (stack_size == 0) {
+    stack_size = os::Horizon::default_stack_size(thr_type);
+    switch (thr_type) {
+    case os::java_thread:
+      // Java threads use ThreadStackSize whose default value can be changed with -Xss.
+      assert(JavaThread::stack_size_at_create() > 0, "this should be set");
+      stack_size = JavaThread::stack_size_at_create();
+      break;
+    case os::compiler_thread:
+      if (CompilerThreadStackSize > 0) {
+        stack_size = (size_t)(CompilerThreadStackSize * K);
+        break;
+      } // else fall through: use VMThreadStackSize if CompilerThreadStackSize is not defined
+    case os::vm_thread:
+    case os::pgc_thread:
+    case os::cgc_thread:
+    case os::watcher_thread:
+      if (VMThreadStackSize > 0) stack_size = (size_t)(VMThreadStackSize * K);
+      break;
+    }
+  }
+  stack_size = MAX2(stack_size, os::Horizon::min_stack_allowed);
+  stack_size = align_size_up(stack_size, (size_t)os::vm_page_size());
+
+  pthread_attr_t attr;
+  int r = pthread_attr_init(&attr);
+  if (r == 0) r = pthread_attr_setstacksize(&attr, stack_size);
+  if (r == 0) r = pthread_create(&ticket->native, &attr, java_start, ticket);
+  pthread_attr_destroy(&attr);
+  if (r != 0) {
+    if (PrintMiscellaneous && (Verbose || WizardMode)) {
+      perror("pthread_create()");
+    }
+    thread->set_osthread(NULL);
+    delete osthread;
+    os::free(ticket);
+    return false;
+  }
+  osthread->set_pthread_id(ticket->native);
+  {
+    Monitor* sync_with_child = osthread->startThread_lock();
+    MutexLockerEx ml(sync_with_child, Mutex::_no_safepoint_check_flag);
+    while (osthread->get_state() == ALLOCATED) {
+      sync_with_child->wait(Mutex::_no_safepoint_check_flag);
+    }
+  }
+  if (osthread->get_state() != INITIALIZED) {
+    guarantee(pthread_join(ticket->native, NULL) == 0, "join failed native initialization");
+    thread->set_osthread(NULL);
+    delete osthread;
+    os::free(ticket);
+    return false;
+  }
+  return true;
+}
