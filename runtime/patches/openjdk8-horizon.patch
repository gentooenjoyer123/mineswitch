+        ldr     t0, [s], #8
+        str     t0, [d], #8
+        sub     count, count, #1
+
+fwd_copy_aligned:
+        ldp     t0, t1, [s, #0]
+        ldp     t2, t3, [s, #16]
+        ldp     t4, t5, [s, #32]
+        ldp     t6, t7, [s, #48]!       // Source now biased by -16
