+  return nxio_stat_path(path, sbuf);
+}
+
+bool os::dir_is_empty(const char* path) {
+  DIR *dir = ::opendir(path);
+  if (dir == NULL) return true;
+  bool result = true;
+  struct dirent* ptr;
+  while ((ptr = ::readdir(dir)) != NULL) {
+    if (strcmp(ptr->d_name, ".") != 0 && strcmp(ptr->d_name, "..") != 0) {
+      result = false;
+      break;
+    }
+  }
+  ::closedir(dir);
+  return result;
+}
