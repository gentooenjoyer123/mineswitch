+
+package sun.nio.fs;
+
+import java.io.IOException;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.attribute.BasicFileAttributeView;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.nio.file.attribute.FileAttributeView;
+
+/**
+ * Default provider for the Horizon SD card. The FAT/exFAT backend has no POSIX
+ * owners or permission bits, so only the basic attribute view is exposed.
+ */
+public class HorizonFileSystemProvider extends UnixFileSystemProvider {
+    public HorizonFileSystemProvider() {
+        super();
+    }
+
+    @Override
+    HorizonFileSystem newFileSystem(String dir) {
+        return new HorizonFileSystem(this, dir);
+    }
+
+    @Override
+    HorizonFileStore getFileStore(UnixPath path) throws IOException {
+        return new HorizonFileStore(path);
+    }
+
+    @Override
+    public <V extends FileAttributeView> V getFileAttributeView(Path obj,
+                                                                Class<V> type,
+                                                                LinkOption... options)
+    {
+        if (type == null)
+            throw new NullPointerException();
+        return type == BasicFileAttributeView.class
+            ? super.getFileAttributeView(obj, type, options) : null;
+    }
+
+    @Override
+    protected DynamicFileAttributeView getFileAttributeView(Path obj,
+                                                            String name,
+                                                            LinkOption... options)
+    {
+        return "basic".equals(name) ? super.getFileAttributeView(obj, name, options) : null;
+    }
+
+    @Override
+    public <A extends BasicFileAttributes> A readAttributes(Path file,
+                                                            Class<A> type,
+                                                            LinkOption... options)
+        throws IOException
+    {
+        if (type == null)
+            throw new NullPointerException();
+        if (type != BasicFileAttributes.class)
+            throw new UnsupportedOperationException("Horizon exposes basic file attributes only");
+        return super.readAttributes(file, type, options);
+    }
+}
