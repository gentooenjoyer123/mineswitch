+bool os::dll_build_name(char* buffer, size_t buflen, const char* pname, const char* fname) {
+  // Copied from the Linux implementation: a name is "built", and dll_load
+  // resolves it against the static registry (there is no file to stat).
+  bool retval = false;
+  const size_t pnamelen = pname ? strlen(pname) : 0;
+  if (pnamelen + strlen(fname) + 10 > (size_t) buflen) {
+    return retval;
+  }
+  if (pnamelen == 0) {
+    jio_snprintf(buffer, buflen, "lib%s.so", fname);
+    retval = true;
+  } else {
+    jio_snprintf(buffer, buflen, "%s/lib%s.so", pname, fname);
+    retval = horizon_has_native_library(fname) != 0;
+  }
+  return retval;
+}
+
+bool os::dll_address_to_function_name(address addr, char* buf, int buflen, int* offset) {
+  bool found = false;
+  pthread_mutex_lock(&library_mutex);
+  for (size_t i = 0; i < library_count && !found; i++) {
+    for (size_t j = 0; j < libraries[i].count; j++) {
+      if (addr == (address)libraries[i].symbols[j].address) {
+        jio_snprintf(buf, buflen, "%s", libraries[i].symbols[j].name);
+        if (offset != NULL) *offset = 0;
+        found = true;
+        break;
+      }
+    }
+  }
+  pthread_mutex_unlock(&library_mutex);
+  if (!found) {
+    if (buflen > 0) buf[0] = '\0';
+    if (offset != NULL) *offset = -1;
+  }
+  return found;
+}
