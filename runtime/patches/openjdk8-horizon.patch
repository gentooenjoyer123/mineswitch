+
+// AMD64 Linux Architecture Description File
+
+//----------OS-DEPENDENT ENCODING BLOCK----------------------------------------
+// This block specifies the encoding classes used by the compiler to
+// output byte streams.  Encoding classes generate functions which are
+// called by Machine Instruction Nodes in order to generate the bit
+// encoding of the instruction.  Operands specify their base encoding
+// interface with the interface keyword.  There are currently
+// supported four interfaces, REG_INTER, CONST_INTER, MEMORY_INTER, &
+// COND_INTER.  REG_INTER causes an operand to generate a function
+// which returns its register number when queried.  CONST_INTER causes
+// an operand to generate a function which returns the value of the
+// constant when queried.  MEMORY_INTER causes an operand to generate
+// four functions which return the Base Register, the Index Register,
+// the Scale Value, and the Offset Value of the operand when queried.
+// COND_INTER causes an operand to generate six functions which return
+// the encoding code (ie - encoding bits for the instruction)
+// associated with each basic boolean condition for a conditional
+// instruction.  Instructions specify two basic values for encoding.
+// They use the ins_encode keyword to specify their encoding class
+// (which must be one of the class names specified in the encoding
+// block), and they use the opcode keyword to specify, in order, their
+// primary, secondary, and tertiary opcode.  Only the opcode sections
+// which a particular instruction needs for encoding need to be
+// specified.
+encode %{
+  // Build emit functions for each basic byte or larger field in the intel
+  // encoding scheme (opcode, rm, sib, immediate), and call them from C++
+  // code in the enc_class source block.  Emit functions will live in the
+  // main source block for now.  In future, we can generalize this by
+  // adding a syntax that specifies the sizes of fields in an order,
+  // so that the adlc can build the emit functions automagically
+
+  enc_class Java_To_Runtime(method meth) %{
+  %}
+
+%}
+
+
+// Platform dependent source
+
+source %{
+
+%}
diff --git a/hotspot/src/os_cpu/horizon_aarch64/vm/horizon_aarch64_context.h b/hotspot/src/os_cpu/horizon_aarch64/vm/horizon_aarch64_context.h
new file mode 100644
index 00000000..766f67c8
--- /dev/null
+++ b/hotspot/src/os_cpu/horizon_aarch64/vm/horizon_aarch64_context.h
@@ -0,0 +1,34 @@
+/* Full own-thread context used by the Horizon AArch64 exception adapter.
+ * The layout is shared with exception_horizon_aarch64.S, not a POSIX ucontext. */
+#ifndef HORIZON_AARCH64_CONTEXT_H
+#define HORIZON_AARCH64_CONTEXT_H
+#include <stdint.h>
+#include <stddef.h>
+
+typedef struct {
+  uint64_t x[31];
+  uint64_t sp;
+  uint64_t pc;
+  uint64_t far;
+  uint64_t fpcr;
+  uint64_t fpsr;
+  uint32_t pstate;
+  uint32_t esr;
+  uint32_t description;
+  uint32_t handled;
+  uint64_t kernel_frame;
+  uint64_t exception_state;
+  unsigned char vectors[32][16];
+} HorizonAArch64Context;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+int horizon_aarch64_exception_thread_init(void);
+void horizon_aarch64_exception_thread_exit(void);
+int horizon_aarch64_handle_exception(HorizonAArch64Context* context);
+void horizon_aarch64_report_unhandled(const HorizonAArch64Context* context);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/hotspot/src/os_cpu/horizon_aarch64/vm/horizon_aarch64_exception_support.c b/hotspot/src/os_cpu/horizon_aarch64/vm/horizon_aarch64_exception_support.c
new file mode 100644
index 00000000..d085b782
--- /dev/null
+++ b/hotspot/src/os_cpu/horizon_aarch64/vm/horizon_aarch64_exception_support.c
@@ -0,0 +1,70 @@
+/* Per-thread alternate exception stack using libnx's public AArch64 frame ABI. */
+#include "horizon_aarch64_context.h"
+#include <switch/arm/thread_context.h>
+#include <switch/kernel/svc.h>
+#include <malloc.h>
+#include <stdlib.h>
+
+enum { HORIZON_EXCEPTION_STACK_BYTES = 128 * 1024 };
+struct HorizonExceptionState {
+  void* stack_top;
+  uint64_t active;
+};
+__thread struct HorizonExceptionState horizon_aarch64_fault_state;
+
+/* Optional launcher diagnostic. Standalone probes have no log pump hook.
+ * The hook must not allocate, walk VM stacks or take the ordinary output lock. */
+extern void horizon_native_fault_report(uint64_t pc, uint64_t far, uint64_t sp,
+    uint64_t lr, uint64_t fp, uint64_t thread_id, uint32_t esr, uint32_t description,
+    const uint64_t* registers, int java_state)
+    __attribute__((weak));
+extern int horizon_aarch64_current_java_state(void) __attribute__((weak));
+
+void horizon_aarch64_report_unhandled(const HorizonAArch64Context* context) {
+  if (horizon_native_fault_report) {
+    u64 thread_id = 0;
+    (void)svcGetThreadId(&thread_id, CUR_THREAD_HANDLE);
+    horizon_native_fault_report(context->pc, context->far, context->sp,
+      context->x[30], context->x[29], thread_id, context->esr, context->description,
+      context->x, horizon_aarch64_current_java_state ? horizon_aarch64_current_java_state() : -1);
+  }
+}
+
+_Static_assert(offsetof(HorizonAArch64Context, sp) == 248, "saved SP offset");
+_Static_assert(offsetof(HorizonAArch64Context, pc) == 256, "saved PC offset");
+_Static_assert(offsetof(HorizonAArch64Context, far) == 264, "saved FAR offset");
+_Static_assert(offsetof(HorizonAArch64Context, fpcr) == 272, "saved FPCR offset");
+_Static_assert(offsetof(HorizonAArch64Context, fpsr) == 280, "saved FPSR offset");
+_Static_assert(offsetof(HorizonAArch64Context, pstate) == 288, "saved PSTATE offset");
+_Static_assert(offsetof(HorizonAArch64Context, esr) == 292, "saved ESR offset");
+_Static_assert(offsetof(HorizonAArch64Context, description) == 296, "description offset");
+_Static_assert(offsetof(HorizonAArch64Context, handled) == 300, "handler result offset");
+_Static_assert(offsetof(HorizonAArch64Context, kernel_frame) == 304, "kernel frame offset");
+_Static_assert(offsetof(HorizonAArch64Context, exception_state) == 312, "TLS state offset");
+_Static_assert(offsetof(HorizonAArch64Context, vectors) == 320, "NEON state offset");
+_Static_assert(sizeof(HorizonAArch64Context) == 832, "exception frame size");
+_Static_assert(offsetof(struct HorizonExceptionState, active) == 8, "TLS active offset");
+_Static_assert(offsetof(ThreadExceptionFrameA64, lr) == 72, "libnx saved LR offset");
+_Static_assert(offsetof(ThreadExceptionFrameA64, sp) == 80, "libnx saved SP offset");
+_Static_assert(offsetof(ThreadExceptionFrameA64, elr_el1) == 88, "libnx saved PC offset");
+_Static_assert(offsetof(ThreadExceptionFrameA64, pstate) == 96, "libnx PSTATE offset");
+_Static_assert(offsetof(ThreadExceptionFrameA64, esr) == 108, "libnx ESR offset");
+_Static_assert(offsetof(ThreadExceptionFrameA64, far) == 112, "libnx FAR offset");
+
+int horizon_aarch64_exception_thread_init(void) {
+  if (horizon_aarch64_fault_state.stack_top != NULL) return 0;
+  void* memory = memalign(16, HORIZON_EXCEPTION_STACK_BYTES);
+  if (memory == NULL) return -1;
+  horizon_aarch64_fault_state.active = 0;
+  horizon_aarch64_fault_state.stack_top = (char*)memory + HORIZON_EXCEPTION_STACK_BYTES;
+  return 0;
+}
+
+void horizon_aarch64_exception_thread_exit(void) {
+  void* top = horizon_aarch64_fault_state.stack_top;
+  if (top == NULL) return;
+  // Never release the storage from its own active exception handler.
+  if (horizon_aarch64_fault_state.active) abort();
+  horizon_aarch64_fault_state.stack_top = NULL;
+  free((char*)top - HORIZON_EXCEPTION_STACK_BYTES);
+}
