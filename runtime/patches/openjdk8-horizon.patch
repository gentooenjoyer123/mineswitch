+
+// HotSpot 8 operating-system layer for Nintendo Switch Horizon (libnx/newlib).
+// Ported from the MineSwitch Java 17/21 Horizon layer (see docs/JAVA17_PORT.md):
+// libnx pthreads with a join reaper, the nxvm/nxjit memory backends, a static
+// JNI symbol registry instead of dlopen, the nxio descriptor bridge for files,
+// and no POSIX signals (the JVM requires -Xrs).
+
+#include "precompiled.hpp"
+#include "classfile/vmSymbols.hpp"
