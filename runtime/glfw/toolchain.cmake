set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER "$ENV{DEVKITA64}/bin/aarch64-none-elf-gcc")
set(CMAKE_AR "$ENV{DEVKITA64}/bin/aarch64-none-elf-ar")
set(CMAKE_RANLIB "$ENV{DEVKITA64}/bin/aarch64-none-elf-ranlib")
set(CMAKE_FIND_ROOT_PATH "$ENV{DEVKITA64}/aarch64-none-elf" "$ENV{DEVKITPRO}/portlibs/switch" "$ENV{DEVKITPRO}/libnx")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec -D__SWITCH__ -D_GNU_SOURCE -ffunction-sections -fdata-sections -I$ENV{DEVKITPRO}/libnx/include -I$ENV{DEVKITPRO}/portlibs/switch/include")
set(NINTENDO_SWITCH ON CACHE BOOL "Build the actual Switch backend")
