+        u64 nanoseconds = (u64) (bounded * 1000000000.0);
+        if (nanoseconds == 0)
+            nanoseconds = 1;
+        waitSingle(waiterForUEvent(&_glfw.nx.wake_event), nanoseconds);
+    }
     _glfwPlatformPollEvents();
 }
 
